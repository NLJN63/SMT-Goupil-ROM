					title GOUPIL4 PC compatible Rom I/O System
					subttl BOOT - boot module

					;	Boot module (int 19) for GOUPIL4

				.list

 = 0000 			ram_dbg 	equ 0			;1 for boot into dbg segment, 0 normally
 = EFC7 			disk_base	equ 0efc7h		;floppy parameter

				else
 0000				boot_seg	segment at 0
				endif
 7C00					org 7c00h
					assume cs:boot_seg
 7C00				bootloc proc far
 7C00	  03 [				db	3 dup (?)		;jump instruction
		??
		    ]

 7C03				bootloc endp
 7C03				boot_seg	ends

 0000				code		segment byte public
					extrn	ds_data:near,putstring:near
					extrn	hdparm_table:near
					public	IPL_FD,IPL_HD
					assume cs:code

 0000  3C 4C 6F 61 64 20	fail_msg	db '<Load error>',07h,0dh,0ah,0
       65 72 72 6F 72 3E
       07 0D 0A 00

 0010				IPL_FD:
 0010  E8 0000 E			call ds_data
					assume ds:data
 0013  C7 06 0078 R EFC7		mov vdiskette_parms,disk_base
 0019  8C 0E 007A R			mov vdiskette_parms+2,cs
 001D  FB				sti				;turn on interrupts
 001E  B8 ---- R			mov ax,boot_seg
 0021  8E C0				mov es,ax
					assume es:boot_seg
 0023  33 D2				xor dx,dx			;read floppy sector 0
 0025  E8 0094 R			call get_sec0
 0028  72 60				jc b_failed			;if error, boot failed
 002A  26: 81 3E 7C00 R E5E5		cmp word ptr bootloc,0e5e5h	;check for garbage
 0031  74 57				je b_failed
 0033  26: 83 3E 7C00 R 00		cmp word ptr bootloc,0
 0039  74 4F				je b_failed

 003B				jmp_boot:
 003B  BE 0000				mov si,0			;for compatibilty (?)
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-2
GOUPIL4 PC compatible Rom I/O System				08-02-85
				BOOT - boot module

 003E  EA 7C00 ---- R			jmp bootloc			;execute boot block

 0043				IPL_HD:
 0043  E8 0000 E			call ds_data
					assume ds:data
 0046  C7 06 0104 R 0000 E		mov vhd_parms,offset hdparm_table ;reset parameter vectors
 004C  8C 0E 0106 R			mov vhd_parms+2,cs
 0050  C7 06 0078 R EFC7		mov vdiskette_parms,disk_base
 0056  8C 0E 007A R			mov vdiskette_parms+2,cs
 005A  FB				sti				;turn on interrupts
 005B  B8 ---- R			mov ax,boot_seg
 005E  8E C0				mov es,ax
					assume es:boot_seg
 0060  33 D2				xor dx,dx			;read floppy sector 0
 0062  E8 0094 R			call get_sec0
 0065  72 13				jc b_hd 			;if error, go directly to hard disk
 0067  26: 81 3E 7C00 R E5E5		cmp word ptr bootloc,0e5e5h	;check for garbage
 006E  74 0A				je b_hd
 0070  26: 83 3E 7C00 R 00		cmp word ptr bootloc,0
 0076  74 02				je b_hd
 0078  EB C1				jmp jmp_boot			;read ok?, execute it
 007A				b_hd:
 007A  B2 80				mov dl,80h			;hard disk req
 007C  E8 0094 R			call get_sec0			;try hard disk boot
 007F  72 09				jc b_failed			;if error, give up
 0081  26: 81 3E 7DFE R AA55		cmp word ptr bootloc + 510, 0aa55h ;valid hard disk boot block?
 0088  74 B1				jz jmp_boot			;if not, we have failed

 008A				b_failed:				;boot attempt has failed
 008A  BE 0000 R			mov si,offset fail_msg
 008D  E8 0000 E			call putstring
 0090				here:
 0090  CD 18				int 18h 			;I give up, go to monitor
 0092  EB FC				jmp here			;in case we return from int 18

 0094				get_sec0:				;read sector 0 from drive in dl into bootloc
									;return carry set if error, reset if ok
 0094  33 C0				xor ax,ax			;reset the drive system
 0096  CD 13				int 13h
 0098  B8 0201				mov ax,201h			;read one sector request
 009B  B9 0001				mov cx,1			;sector 1, cyl 0
 009E  32 F6				xor dh,dh			;head 0
 00A0  BB 7C00 R			mov bx,offset bootloc
 00A3  89 87 01FE			mov 510[bx],ax			;force last word to be not aa55
 00A7				disk_op:				;do a disk operation with retries
 00A7  57				push di
 00A8  BF 0004				mov di,4			;if we don't get it in 4 retries, give up
 00AB				disk_retry_loop:
 00AB  50				push ax 			;save disk op in ah
 00AC  CD 13				int 13h
 00AE  72 03				jc do_20			;if error, do retry looping
 00B0  58				pop ax				; balance stack, restore ax
 00B1  5F				pop di				; restore di
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-3
GOUPIL4 PC compatible Rom I/O System				08-02-85
				BOOT - boot module

 00B2  C3				ret				; disk_op done
 00B3				do_20:
 00B3  F6 C4 80 			test ah,80h			;not ready error?
 00B6  74 03				jz do_30			;other errors, just continue
 00B8  BF 0001				mov di,1			;no retries on not ready errors
 00BB				do_30:
 00BB  B4 00				mov ah,0
 00BD  CD 13				int 13h 			;reset
 00BF  58				pop ax
 00C0  4F				dec di
 00C1  75 E8				jnz disk_retry_loop		;go till retry count zeroes
 00C3  F9				stc				;return an error flag
 00C4  5F				pop di				;restore di
 00C5				get_out:
 00C5  C3				ret

 00C6				code	ends
					end
