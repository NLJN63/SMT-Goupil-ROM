 The Microsoft MACRO Assembler , Version 1.27 		Page	1-3
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				SWRE - software reset


				;************************************************************************
				;*
				;*		H/W reset jumps here to clear reset flag
				;*
				;************************************************************************

 E050				clr_res:			;clear reset flag
					assume ds:data
 E050  33 C0				xor ax,ax		;clear data seg
 E052  8E D8				mov ds,ax
 E054  A3 0472 R			mov reset_flag,ax	;clear reset flag
 E057  EB 02 90 			jmp start_mod

				;************************************************************************
				;*
				;*		PC compatible entry, f000:e05b
				;*
				;************************************************************************

					morg	0e05bh
 E05B			      + 	org 0e05bh
 E05B				start_mod:	;	start module for PROMS
 E05B  BA FFA2				MOV	DX,0FFA2H		;LOWER MEMORY (RAM)
 E05E  B8 3FF8				MOV	AX,3FF8H+0		;256K
 E061  EF				OUT	DX,AX
 E062  BA FFA8				MOV	DX,0FFA8H		;MIDDLE MEMORY BLOCK SIZE
 E065  B8 A039				MOV	AX,0A038H+1
 E068  EF				OUT	DX,AX
 E069  BA FFA6				MOV	DX,0FFA6H		;BASE ADDRESS
 E06C  B8 81F9				MOV	AX,81F8H+1
 E06F  EF				OUT	DX,AX
 E070  EA				db	0eah			;go to start
 E071  C000				dw	0c000h
 E073  F000				dw	0f000h

				;***************	End Of PROM Data	*****************

 E075				code	ends
					end
