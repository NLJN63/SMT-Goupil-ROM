				;===================================
 0000				code	segment public byte

					assume cs:code, ds:data

				; PRINT SCREEN
 0000				PRTSCR:
 0000  CD 11				INT	11H			;GET EQUIP FLAGS
 0002  24 30				AND	AL,30H			;VIDEO BOARD?
 0004  74 5B				JZ	PRTRET			;NO. RETURN
 0006  80 3E 0500 R 01			CMP	PRTSCR_FLAG,1		;PRINT IN PROGRESS?
 000B  74 54				JE	PRTRET			;YES. RETURN
 000D  C6 06 0500 R 01			MOV	PRTSCR_FLAG,1		;SET PRINT SCREEN STATUS
 0012  B4 03				MOV	AH,3			;GET CURRENT CURSOR POSITION
 0014  CD 10				INT	10H
 0016  8B F2				MOV	SI,DX			;SAVE CURRENT CURSOR POSITION
 0018  B4 0F				MOV	AH,15			;GET SCREEN MODE
 001A  CD 10				INT	10H
 001C  8A C4				MOV	AL,AH			;NUMBER OF COLUMNS PER LINE
 001E  32 E4				XOR	AH,AH
 0020  8B F8				MOV	DI,AX			;SAVE IT
 0022  E8 006A R			CALL	PRTNLN			;PRINT NEW LINE
 0025  33 D2				XOR	DX,DX			;START WITH (0,0) CURSOR
 0027  B9 0019				MOV	CX,25			;LINE COUNTER
 002A  51			PRTLUP1:PUSH	CX			;SAVE LINE COUNT
 002B  8B CF				MOV	CX,DI			;COLUMNS COUNTER
 002D  B4 02			PRTLUP2:MOV	AH,2			;SET CURSOR POSTION
 002F  CD 10				INT	10H
 0031  B4 08				MOV	AH,8			;GET CHARACTER AT CURSOR
 0033  CD 10				INT	10H
 0035  0A C0				OR	AL,AL			;BINARY ZERO?
 0037  75 02				JNZ	PRTCHR			;NO. BR TO PRINT
 0039  B0 20				MOV	AL,20H			;ELSE. CONVERT TO A BLANK
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-3
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				PRSCR - print screen

 003B  52			PRTCHR: PUSH	DX			;SAVE CURSOR POSITION
 003C  33 D2				XOR	DX,DX			;USE PRINTER NO. 1
 003E  32 E4				XOR	AH,AH			;PRINT CHARACTER IN (AL)
 0040  CD 17				INT	17H
 0042  5A				POP	DX			;RESTORE CURSOR
 0043  80 E4 29 			AND	AH,00101001B		;PRINTER ERROR
 0046  75 1A				JNZ	PRTERR			;YES
 0048  FE C2				INC	DL			;ADVANCE TO NEXT COLUMN
 004A  E2 E1				LOOP	PRTLUP2 		;COLUMN LOOP
 004C  E8 006A R			CALL	PRTNLN			;PRINT NEW LINE
 004F  32 D2				XOR	DL,DL			;ELSE. RESET COLUMN
 0051  FE C6				INC	DH			;ADVANCE TO NEXT LINE
 0053  59				POP	CX
 0054  E2 D4				LOOP	PRTLUP1 		;LINE LOOP
 0056  C6 06 0500 R 00			MOV	PRTSCR_FLAG,0		;CANCEL PRINT SCREEN STATE
 005B  8B D6			PRTREST:MOV	DX,SI			;RESTORE ORIGINAL CURSOR
 005D  B4 02				MOV	AH,2			;SET ORIGINAL CURSOR
 005F  CD 10				INT	10H
 0061  C3			PRTRET: RET
 0062  59			PRTERR: POP	CX			;BALANCE STACK
 0063  C6 06 0500 R FF			MOV	PRTSCR_FLAG,-1		;SET ERROR STATUS
 0068  EB F1				JMP	PRTREST
				; PRINT NEW LINE
 006A  50			PRTNLN: PUSH	AX			;2
 006B  52				PUSH	DX			;0
 006C  33 D2				XOR	DX,DX			;PRINTER 0
 006E  32 E4				XOR	AH,AH			;PRINT FUNCTION
 0070  B0 0A				MOV	AL,LF
 0072  CD 17				INT	17H
 0074  32 E4				XOR	AH,AH			;PRINT FUNCTION
 0076  B0 0D				MOV	AL,CR
 0078  CD 17				INT	17H
 007A  5A				POP	DX			;0
 007B  58				POP	AX			;2
 007C  C3				RET

 007D				code	ends
					end
