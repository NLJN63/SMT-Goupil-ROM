 C2DC				checksum_test:; checksum test, starting addr in cs:bx
 C2DC  33 C0				xor ax,ax;	clear checksum accumulators
 C2DE				csloop:
 C2DE  2E: 02 87 C000			add al,byte ptr cs:0C000h[bx]; add odd offsets into al accumulator
 C2E3  4B				dec bx
 C2E4  2E: 02 A7 C000			add ah,byte ptr cs:0C000h[bx]; add even offsets into ah accumulator
 C2E9  83 EB 01 			sub bx,1;	subtract to get carry flag on rollover
 C2EC  73 F0				jnc csloop;	go till carry from 0 to ffff
 C2EE  0A E0				or ah,al;	ah = al = 0 if checksum correct

					endif

 C2F0  74 03				jz cs_err		;checksum error!
 C2F2  B4 06				mov ah,chksum_ID	;set test ID
 C2F4  F9				stc			;flag error
 C2F5				cs_err:
