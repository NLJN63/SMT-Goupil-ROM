				;************************************************************************
				;*									*
				;*		DEV_Init public 					*
				;*									*
				;************************************************************************
				;*									*
				;*	parallel printer driver initialization				*
				;*									*
				;*	ENTRY:	none							*
				;*	EXIT:	none							*
				;*									*
				;*	MODIFIES:	Interrupt Vector at 0:5Ch			*
				;*			All GP registers				*
				;*									*
				;************************************************************************
 DF00				DEV_Init:				; first thing driver module
 DF00  9C				pushf				; no interrupts allowed
 DF01  FA				cli

 DF02  1E				push	ds			; DS is used
				Dseg	IVT using ax
 DF03  B8 ---- R	      + 	mov	ax, IVT
 DF06  8E D8		      + 	mov	ds, ax

				;------ set up related IVT's ---------

 DF08  C7 06 005C DF15 R		mov	IVT:[17h*4].LW, offset Cgroup:PAR_RIOS_entry	; PAR RIOS entry
 DF0E  8C 0E 005E			mov	IVT:[17h*4].HW, cs

 DF12  1F				pop	ds
 DF13  9D				popf				; restore interrupt state
 DF14  C3				ret
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-8
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMPAR -	parallel printer driver

				  page
				;************************************************************************
				;*									*
				;*		PAR_Rios public 					*
				;*									*
				;************************************************************************
				;*									*
				;*	RIOS Parallel Printer Port -- supports three RIOS calls, which	*
				;*	support upto three printers.					*
				;*									*
				;*	AH = Function code as follows:					*
				;*----------------------------------------------------------------------*
				;*	Fn0: print character						*
				;*									*
				;*	ENTRY:	AH= 0							*
				;*		AL= char						*
				;*									*
				;*	EXIT:	AH= status						*
				;*----------------------------------------------------------------------*
				;*	Fn1: Initialize printer port					*
				;*									*
				;*	ENTRY:	AH=1							*
				;*									*
				;*	EXIT:	AH= status						*
				;*----------------------------------------------------------------------*
				;*	Fn2: Return Printer Status					*
				;*									*
				;*	ENTRY:	AH=2							*
				;*									*
				;*	EXIT:	AH= status						*
				;*		eight bit flags:					*
				;*			BIT0: Time Out					*
				;*			BIT1: unused					*
				;*			BIT2: unused					*
				;*			BIT3: I/O Error 				*
				;*			BIT4: Selected					*
				;*			BIT5: Out of Paper				*
				;*			BIT6: Acknowledge				*
				;*			BIT7: NOT Busy					*
				;*									*
				;************************************************************************

 DF15				PAR_RIOS_entry:
 DF15  FB				sti				; allow interrupts
 DF16  1E				push	DS			; save registers used
 DF17  52				push	dx
 DF18  51				push	cx
 DF19  53				push	bx
 DF1A  50				push	ax

				    set_RDP bx
 DF1B  BB ---- R	      + 	mov	bx, RDP
 DF1E  8E DB		      + 	mov	ds, bx
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-9
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMPAR -	parallel printer driver

 DF20  8B DA				mov	bx, dx			; save printer #

 DF22  8A 8F 0000 E			mov	cl, par_timeout[bx]	; get timeout delay
					clr	ch			; adjust for 186???
 DF26  32 ED		      + 	xor	ch,ch
 DF28  D1 E1				shl	cx, 1

 DF2A  D1 E3				shl	bx, 1
 DF2C  8B 97 0000 E			mov	dx, par_base[bx]	; get I/O channel base
 DF30  0B D2				or	dx, dx			; check for live one
 DF32  74 47				je	par_exit		; NA

 DF34  80 FC 01 			cmp	ah, 1
 DF37  77 38				ja	par_2			; Fn 2
 DF39  74 23				je	par_1			; Fn 1

				;------ PAR RIOS Function 0 -- print data ---------

 DF3B				par_0:
 DF3B  EE				out	dx,al			; xx8 -- output char
 DF3C  42				inc	dx
 DF3D				p0a:
					clr	bx
 DF3D  33 DB		      + 	xor	bx,bx
 DF3F				p0b:
 DF3F  EC				in	al,dx			; xx9 -- check busy
 DF40  8A E0				mov	ah,al
 DF42  0A C0				or	al, al
 DF44  78 0D				js	p0c			; data accepted

 DF46  4B				dec	bx			; dec wait counter
 DF47  75 F6				jne	p0b

 DF49  E2 F2				loop	p0a			; dec wait counter

 DF4B  80 E4 F8 			and	ah, 0F8h		; return 5 bits
 DF4E  80 F4 49 			xor	ah,49h			; makes status<>0
					jmps	par_Exit
 DF51  EB 28		      + 	jmp	short	par_Exit

 DF53				p0c:					; handshake to printer
 DF53  B0 0D				mov	al,0dh
 DF55  42				inc	dx
 DF56  EE				out	dx,al			; xxA -- strobe on
 DF57  FE C8				dec	al
 DF59  EE				out	dx,al			; xxA -- strobe off
 DF5A  4A				dec	dx			; set port to base
 DF5B  4A				dec	dx
					jmps	par_2
 DF5C  EB 13		      + 	jmp	short	par_2

				;------ PAR RIOS Function 1 -- initialize printer H/W ---------

 The Microsoft MACRO Assembler , Version 1.27 		Page	1-10
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMPAR -	parallel printer driver

 DF5E				par_1:
 DF5E  42				inc	dx			; xxA -- set to control port
 DF5F  42				inc	dx
 DF60  B0 08				mov	al,8			; reset printer
 DF62  EE				out	dx,al
 DF63  B9 0FA0				mov	cx,4000 		; wait for reset
 DF66				par_1a:
 DF66  E2 FE				loop	par_1a

 DF68  B0 0C				mov	al,0ch			; clear reset
 DF6A  EE				out	dx,al

 DF6B  4A				dec	dx			; xx8 -- base port
 DF6C  4A				dec	dx
 DF6D  33 C9				xor	cx,cx			;pause before reading status
 DF6F				par_1b:
 DF6F  E2 FE				loop	par_1b

				;------ PAR RIOS Function 2 -- return printer status ---------

 DF71				par_2:
 DF71  42				inc	dx			; xx9 -- set to status port
 DF72  EC				in	al,dx
 DF73  8A E0				mov	ah,al
 DF75  80 E4 F8 			and	ah, 0F8h
 DF78  80 F4 48 			xor	ah,48h			; makes status=0  ok

 DF7B				par_exit:
 DF7B  5A				pop	dx			; restore AL
 DF7C  8A C2				mov	al,dl

 DF7E  5B				pop	bx
 DF7F  59				pop	cx
 DF80  5A				pop	dx
 DF81  1F				pop	DS
 DF82  CF				iret

 DF83				code	ends
					end
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-1
GOUPIL4 PC compatible Rom	I/O System				08-02-85


					page ,132
					title GOUPIL4 PC compatible Rom I/O System
					subttl SWRE - software reset

					;	Link this module to the PC compatible reset offset

			     C	include macros.inc
			     C
			     C	morg	macro	 arg1  ;overlap detection macro
			     C		if1
			     C		if $ gt arg1
			     C		%out morg arg1 overlapping something!!!
			     C		endif
			     C		endif
			     C		org arg1
			     C		endm
			     C
			     C	link	macro	arg1,arg2	;set and print binlink info
			     C		if1
			     C		.radix	16
			     C		outmsg	cut,arg1,%(arg2)
			     C		outmsg	binlink,arg1,%(arg2-0c000h)
			     C		.radix	10
			     C		endif
			     C		org	arg2
			     C		endm
			     C
			     C	outmsg	macro	arg1,arg2,arg3
			     C		%out arg1 arg2 to arg3
			     C		endm
			     C

