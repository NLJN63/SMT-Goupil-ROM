 = 0000 			null		equ	0
 = 005B 			begnest 	equ	'['		;begining of a nest char
 = 005D 			endnest 	equ	']'		;end of a nest char
 = 003A 			seg_delim	equ	':'		;segment/offset delimiter

					assume cs:code, ds:data

