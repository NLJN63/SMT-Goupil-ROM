					title	GOUPIL4 PC compatible Rom I/O System
					subttl	HD - hard disk interface

					;	prom hard disk interface for GOUPIL4

					;	this code replaces the int 13 code for
					;	floppy disk.  the floppy disk int is
					;	swapped into int 40, and any int 13 with
					;	bit 7 of dl NOT set will be passed
					;	directly to the floppy interrupt (int 40)

					;	four lockout requests are included to support
					;	removable hard disks

				;CHANGES:
				;	date	release name, change


				.list
			     C		include biosdata.inc
			     C	;	BIOS DATA page
			     C
