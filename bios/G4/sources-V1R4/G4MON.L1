 0579				rq_wait:	;return z set if error, reset if no error
 0579  51				push cx 		;save callers cx
 057A  33 C9				xor cx,cx
 057C				rq_loop:
 057C  E8 05F6 R			call get_stat_port
 057F  EC				in al,dx
 0580  A8 01				test al,rq_bit
 0582  E1 F8				loopz rq_loop
 0584  59				pop cx			;restore cx
 0585  24 0F				and al,0fh		;clear upper nibble
 0587  C3				ret

 0588				hd_wait:
 0588  E8 0605 R			call getparmptr 	;get pointer to parm table into es:bx
 058B  26: 8A 67 0B			mov ah,es:11[bx]	;store diag timeout in ah
 058F  26: 8B 5F 09			mov bx,es:9[bx] 	;timeout for most commands in dx, format in dh
 0593  A0 0442 R			mov al,hd_cmd+0 	;get latest disk op into al
 0596  3C E3				cmp al,drv_diag_xcmd	;drive diag command??
 0598  75 04				jnz hdw_20
 059A  8A DC				mov bl,ah		;timeout for drive diag
					jmps op_wait
 059C  EB 06		      + 	jmp short op_wait
 059E				hdw_20:
 059E  3C 04				cmp al,form_drv_xcmd	;format drive command??
 05A0  75 02				jnz op_wait
 05A2  8A DF				mov bl,bh		;bh had es:10[si] from mov bx, above

 05A4				op_wait:
 05A4  32 FF				xor bh,bh
 05A6  03 DB				add bx,bx		;four times
 05A8  03 DB				add bx,bx
 05AA  33 C9				xor cx,cx		;clear loop counter
 05AC				wait_loop:
 05AC  E8 05F6 R			call get_stat_port
 05AF  EC				in al,dx		;read status
 05B0  24 0F				and al,0fh		;mask off upper nibble
 05B2  3C 0F				cmp al,rq_bit+busy_bit+io_bit+cd_bit
								;wait till we get 0fh in status (op done)
 05B4  75 0B				jnz wl_10
 05B6  E8 05EC R			call get_dat_port	;read return byte from drive
 05B9  EC				in al,dx
 05BA  A8 02				test al,00000010b	;test for error bit
 05BC  B0 BB				mov al,gen_hderr	;assume general error
 05BE  75 A4				jnz j1_set_status	;if error, set carry and return
 05C0  C3				ret			;return with carry reset
 05C1				wl_10:
 05C1  F6 46 0E FF			test byte ptr bp_dmamod[bp],0ffh	;is this a dma op?
 05C5  74 1B				jz wl_20		;if not, continue
 05C7  E4 08				in al,dmacmd		;read dma status
 05C9  A8 08				test al,dma3_done	;done yet?
 05CB  74 15				jz wl_20		;no, continue to wait
