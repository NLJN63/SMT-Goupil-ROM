					;GOUPIL4 monitor
					;display, set, move, and fill memory
					;read and write I/O
					;read and write floppy and hard disk
					;boot operating system (int 19)
					;transfer control (jump)

				;****** CHANGES *********
				;	Date	Release Name, Change:

				.list

					public monitor
					public ram_start

 0000				hwres	segment at 0ffffh
 0000					org 0
 0000				hard_reset	proc	far		;hardware reset entry point
 0000				hard_reset	endp
 0000				hwres	ends

 0000				code	segment byte public

					extrn crlf:near,putstring:near,putchar:near,putword:near
					extrn putbyte:near,putdec:near,putnib:near
					extrn getchar:near,keybrdchk:near

