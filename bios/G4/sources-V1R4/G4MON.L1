 C000			      + 	org	0c000h
					assume cs:code

 C000  EB 11				jmp	short pod_entry 	;skip version message

 C002  FE 24					db	0feh,24h	;reserved to put the crc
 C004  47 34 4D 4F 4E 2D	g4mon_ver	db	'G4MON-186 V1R4',0
       31 38 36 20 56 31
       52 34 00

 C013				pod_entry:		; POD code STARTS HERE !!!
 C013  FA				cli;		prevent maskable interrupts from occuring
 C014  FC				cld;		direction up

 C015  B8 0000				mov ax,0;	clear sign,zero,aux cy,parity and cy
 C018  E6 A0				out 0a0h,al;	disable NMI hardware

 C01A				flag_test:;	processor flag test
 C01A  9E				sahf;		clear all flags

 C01B  78 1D				js halt;	sign cleared?
 C01D  74 1B				jz halt;	zero cleared?
 C01F  7A 19				jp halt;	parity cleared?
 C021  72 17				jc halt;	carry cleared?

 C023  B0 EF				mov al,not 10h; test aux carry
 C025  22 E0				and ah,al
 C027  75 11				jnz halt

 C029  B4 D5				mov ah,0d5h;		set sign,zero,aux cy,parity and cy
 C02B  9E				sahf

 C02C  79 0C				jns halt;	sign set?
 C02E  75 0A				jnz halt;	zero set?
 C030  7B 08				jnp halt;	parity set?
 C032  73 06				jnc halt;	carry set?

 C034  B0 EF				mov al,not 10h; test aux carry
 C036  22 E0				and ah,al
 C038  75 02				jnz reg_test

 C03A				halt:;	hangup in a loop doing nothing....
 C03A  EB FE				jmp halt

 C03C				reg_test:;	test CPU registers with patterns

					else
 C03C  B8 AAAA				mov ax,0aaaah
 C03F				rt20:
