 060F  EC				in al,dx		;read switches (bit 0 = jmpr4, bit 3 = jmpr1)
 0610  F6 06 0443 R 20			test hd_cmd+1,00100000b ;odd or even drive?
 0615  75 04				jnz gpp_20
