 0007  0D 0A 00 		crlf_msg db	0dh,0ah,0

 000A				crlf:
 000A  56				push si
 000B  BE 0007 R			mov si,offset crlf_msg
 000E  E8 0016 R			call putstring
 0011  5E				pop si
