					;	test for manufacturing mode
 C08C  BE C092 R			mov si,offset pe40;		return address
 C08F  E9 C4F8 R			jmp j_get_switch;		get switch setting
 C092				pe40:
 C092  BF C07B R			mov di,offset cmd_continue;	return address if not manf mode
 C095  A8 02				test al,02h;			manufacturing test mode?
 C097  74 03				jz rep_beep;			beep out test ID and return

					;	loop on beeping out test ID
 C099  BF C08A R			mov di,offset pe20;		return address (loop)
 C09C				rep_beep:;	beep for count in bh (NORAM, return di)
 C09C  8A DF				mov bl,bh;		copy the count
 C09E  8B F7				mov si,di;		save return address
 C0A0				rep_beep_loop:
 C0A0  BF C0A6 R			mov di,offset spkr_on
 C0A3  EB 14 90 			jmp j_tone
 C0A6				spkr_on:
 C0A6  33 C9				xor cx,cx

 C0A8				spkr_off:
 C0A8  E2 FE				loop spkr_off
 C0AA  FE CB				dec bl
 C0AC  75 F2				jnz rep_beep_loop
 C0AE  8A DF				mov bl,bh;		get the count again
 C0B0				off_delay:
 C0B0  E2 FE				loop off_delay; 	pause proportianal to count
 C0B2  FE CB				dec bl
 C0B4  75 FA				jnz off_delay
 C0B6  FF E6				jmp si; 		return

 C0B8				pod_tone:;
 C0B8  5F				pop di			;get return address from stack
					;drop thru to j_tone
 C0B9				j_tone:;	generate a tone for a moment (NORAM, return di)
 C0B9  BA 0061				mov dx,PARPTB
 C0BC  EC				in al,dx
 C0BD  0C 03				or al,3h;		set speaker gates on
 C0BF  EE				out dx,al;		speaker is now on
 C0C0  33 C9				xor cx,cx
