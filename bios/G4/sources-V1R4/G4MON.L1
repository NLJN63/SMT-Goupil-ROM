 03FE				RSS_table:		;conversion table for xebec to DOS errors
 03FE  00 00 00 			db 00h,0,0		;no error
 0401  01 20 01 			db 01h,cntrlr_hderr,1	;no index from drive
 0404  02 40 01 			db 02h,seek_hderr,1	;no seek complete
 0407  03 20 01 			db 03h,cntrlr_hderr,1	;write fault from drive
 040A  04 80 01 			db 04h,timeout_hderr,1	;drv not ready after select
 040D  06 20 01 			db 06h,cntrlr_hderr,1	;track 0 not found
 0410  08 40 01 			db 08h,seek_hderr,1	;drive still seeking
 0413  10 10 00 			db 10h,ecc_hderr,0	;id field read error
 0416  11 10 00 			db 11h,ecc_hderr,0	;uncorrectable data error
 0419  12 02 00 			db 12h,addr_mark_hderr,0;no address mark on drive
 041C  14 04 00 			db 14h,not_fnd_hderr,0	;record not found (id match error)
 041F  15 40 00 			db 15h,seek_hderr,0	;seek error
 0422  18 11 00 			db 18h,ecc_ok_hderr,0	;data ecc corrected
 0425  19 0B 00 			db 19h,track_hderr,0	;bad track flag
 0428  20 01 00 			db 20h,cmd_hderr,0	;bad command
