				;--------------------------------------------------------
 C5BD				pgm_io:;use table at cs:si to program an I/O device for cx control bytes
					;the first entry in the table is the 16 bit address of the device
					;the following entries are low address-control byte...
					;to save table space, only the least significant 8 bits
					;of address are set thru the rest of the table
 C5BD  5F				pop di; 	get return address from stack
					;	drop thru to jpgm_io
				;--------------------------------------------------------
 C5BE				jpgm_io:;	(NORAM return to di)
 C5BE  2E: AD				lods word ptr jpgm_io;	 get device address
 C5C0  8B D0				mov dx,ax
