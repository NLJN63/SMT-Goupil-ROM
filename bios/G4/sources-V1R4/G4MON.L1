 C363				RAM_test:;	test RAM in 16KB blocks
					;	number of 16K's in bl
					;	starting segment in ax
 C363  8E C0				mov es,ax
 C365  BE C36B R			mov si,offset ramt40;	set return address
 C368				ramt_loop:
 C368  EB 30 90 			jmp RAM_test16K;	test a 16K block starting at es:0
 C36B				ramt40:
