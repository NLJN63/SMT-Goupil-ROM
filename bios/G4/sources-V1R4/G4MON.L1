 0571  8A 16 0501 R			mov dl,drive_addr		;set drive address
 0575  A0 0508 R			mov al,sector_count		;set number of sectors to read
 0578  C4 1E 050F R			les bx,disk_buf_dword		;setup transfer address
 057C  8A 26 0507 R			mov ah,disk_req 		;set the disk request
 0580				res_10:
 0580  CD 13				int 13h 			;do the disk interrupt
 0582  88 26 0506 R			mov disk_rc,ah			;save return code
 0586  C3				ret

 0587				drive:		;set drive address
 0587  E8 0147 R			call gethex
 058A  88 16 0501 R			mov drive_addr,dl		;set drive number
 058E  C3				ret

 058F				cylinder:	;set drives cylinder address
 058F  E8 0164 R			call getdec
 0592  89 16 0502 R			mov cyl_addr,dx 		;set cylinder address
 0596  C3				ret

 0597				head:		;set drives head address
 0597  E8 0164 R			call getdec
 059A  88 16 0504 R			mov head_addr,dl		;set head address
 059E  C3				ret

 059F				sector: 	;set drives sector address
 059F  E8 0164 R			call getdec
 05A2  75 02				jnz sector_20			;no number?
