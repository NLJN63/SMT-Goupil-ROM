 C043  8E D6				mov ss,si
 C045  8C D3				mov bx,ss
 C047  8B E3				mov sp,bx
 C049  8B EC				mov bp,sp
 C04B  8E C5				mov es,bp
 C04D  8C C1				mov cx,es
 C04F  8B F9				mov di,cx
 C051  8B D7				mov dx,di

 C053  33 D0				xor dx,ax
 C055  75 E3				jnz halt


 C057  D1 E8				shr ax,1;	change pattern
 C059  72 E4				jc rt20;	quit after two patterns
					endif

 C05B  BA FFFE				mov dx,ICBRRG
 C05E  ED				in ax,dx;		read default relocation register
 C05F  0D 4000				or ax,4000h;		turn on RMX compatability bit
 C062  EF				out dx,ax

 C063				cmd_entry:;	processor tests have passed, test remaining system devices

 C063  33 C0				xor ax,ax
 C065  8E C0				mov es,ax;		set es and ds to low memory segment
 C067  8E D8				mov ds,ax
					assume ds:data

					if ram_dbg - TRUE
 C069  8C C8				mov ax,cs
 C06B  8E D0				mov ss,ax;		ss <== cs, set up initial 'NO RAM' stack
 C06D  B8 C0CB R			mov ax,offset PROM_STACK
 C070  8B E0				mov sp,ax
					endif

 C072  BD C0CB R			mov bp,offset cmd_tbl;	pointer to tests
 C075				cmdloop:
 C075  2E: FF 56 00			call word ptr cs:[bp];		 do the command
 C079				cmdret:;			command returns to here (with any luck)
 C079  72 04				jc j_pod_err;		cy true if failure
 C07B				cmd_continue:
 C07B  45				inc bp; 		prepare for next command
 C07C  45				inc bp
 C07D  EB F6				jmp cmdloop

 C07F				j_pod_err:;	error detected in PODs, tests ID in ah (NORAM return di)
					;	post test ID in reset_flag (in RAM)
 C07F  B0 9C				mov al,pod_fail_flag
 C081  3A 06 0472 R			cmp al,byte ptr reset_flag;	has a pod error already been set?
 C085  74 03				jz pe20;			if so, don't set a new one
