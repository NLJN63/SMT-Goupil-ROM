 C37A				RAM_err:;	memory failure, expected pattern in al
					;	set up an accumulator (es) to hold RAM error information:
					;		high byte flag		bit 12
					;		bank number		bits 10,9 and 8
					;		radial error bit(s)	bits 7 thru 0
 C37A  26: 8A 5D FF			mov bl,es:[di-1];read last word
 C37E  8C C2				mov dx,es;	setup bank number into dh
 C380  B1 05				mov cl,5
 C382  D2 EE				shr dh,cl
					;	setup bit error(s) and high byte flag
 C384  80 E6 EF 			and dh,0efh;	reset high byte flag (error offset is even)
 C387  F7 C7 0001			test di,1;	was error_offset+1 odd?
 C38B  75 03				jnz rtf20
 C38D  80 CE 10 			or dh,10h;	set high byte flag (error offset is odd)
 C390				rtf20:
 C390  32 C3				xor al,bl;	set bits in error
 C392  8A D0				mov dl,al
 C394  8E C2				mov es,dx;		es now has: high/low byte, bank and bits(s)
 C396  B4 04				mov ah,loram_ID 	;set low ram ID, may be changed by caller
 C398  F9				stc			;flag error
 C399  C3				ret

