 004C			     C		org 13h*4
 004C  ????		     C	vdisk_int	dw ?
 0064			     C		org 19h*4
 0064  ????		     C	vboot_int	dw ?
 0078			     C		org 1eh*4
 0078  ????		     C	vdiskette_parms dw ?
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-2
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				SWRE - software reset

 0100			     C		org 40h*4
 0100  ????		     C	vdiskette_int	dw ?
 0104			     C		org 41h*4
 0104  ????		     C	vhd_parms	dw ?
			     C
			     C	;misc. system data
 0400			     C		org 400h
 0400	  04 [		     C	rs232_base	dw 4 dup (?)
		????	     C
		      ]      C
			     C
 0408			     C		org 408h
 0408	  04 [		     C	prt_base	dw 4 dup (?)
		????	     C
		      ]      C
			     C
 0410			     C		org 410h
 0410  ????		     C	eqflag		dw ?
 0412			     C		org 412h
 0412  ??		     C	mfg_flag	db ?
 0413			     C		org 413h
 0413  ????		     C	memsiz		dw ?
 0442			     C		org 442h
 0442			     C	hd_RSS	label byte		;return bytes from RSS
 0442  ??		     C	hd_cmd		db ?		;command block
 0472			     C		org 472h
 0472  ????		     C	reset_flag	dw ?
 0474			     C		org 474h
 0474  ??		     C	hd_status	db ?
 0475  ??		     C	n_drives	db ?
 0476  ??		     C	hd_flags	db ?
 0477  ??		     C	hd_cbits	db ?		;change status bits
 0478			     C		org 478h
 0478	  04 [		     C	prt_timout	db 4 dup (?)
		??	     C
		    ]	     C
