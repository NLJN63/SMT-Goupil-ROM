 03A0  C3				ret

 03A1				lock_reqs:		;special lockout commands for changeable media
							;the idea here is that changing hard disk media
							;can foul up the operating system if the hard disk
							;driver always returns NO CHANGE.  We detect changes
							;by reading READY status every 10 to 20 seconds.
							;if ever not ready, we will return errors to every
							;request until RESET_CHANGE_STATUS is requested.
							;Also, format can set media changed status to force
							;a rebuild BPB req

 03A1  E8 03F5 R			call bin_to_rad 	;convert binary dl (drive) to bits in al
 03A4  8A 66 00 			mov ah,bp_al[bp]	;get al parm (lockout request)
 03A7  22 E4				and ah,ah
 03A9  74 43				jz reset_change_status
 03AB  FE CC				dec ah
 03AD  74 10				jz poll_ready_flag
 03AF  FE CC				dec ah
 03B1  74 2F				jz get_change_status
 03B3  FE CC				dec ah			;check lock op
 03B5  74 03				jz set_change_status
 03B7  E9 02D8 R			jmp set_cmd_err

 03BA				set_change_status:	;set the media changed bit
 03BA  08 06 0477 R			or hd_cbits,al		;set bit for drive
 03BE  C3				ret

 03BF				poll_ready_flag:	;set PENDING flag so that poll_ready_status
							;will be called (after BUSY is turned off)
 03BF  80 0E 0476 R 40			or hd_flags,HD_PENDING
 03C4  C3				ret

 03C5				poll_ready_status:	;test all drives for ready - set media bit if not
 03C5  E8 03F5 R			call bin_to_rad 		;may be called directly
 03C8  80 26 0476 R BF			and hd_flags,not HD_PENDING	;reset pending flag
 03CD  8A 16 0475 R			mov dl,n_drives 	;set dx register to number of drives
 03D1  80 CA 80 			or dl,80h		;hard disk requests
 03D4				pc_loop:
 03D4  FE CA				dec dl			;next drive address
 03D6  F6 C2 80 			test dl,80h		;see if we have gone to 7fh
 03D9  75 01				jnz pc_10		;if still more drives, continue
 03DB  C3				ret
 03DC				pc_10:
 03DC  B4 10				mov ah,rdy_cmd		;test drive ready
 03DE  CD 13				int disk_int		;if not ready, changed media bit will be set
					jmps pc_loop
