					page ,132
					title GOUPIL4 PC compatible Rom I/O System
					subttl POD - power on diagnostics

					;	Power On Diagnostics
					;	for the GOUPIL4 computer

				.list
			     C		include mioshdw.inc
			     C	;------------------------------ 		--04/27/84--
			     C	; HARDWARE MAP FOR GOUPIL4
			     C	;------------------------------
			     C	; 80186 INTERNAL CONTROL BLOCK
			     C	; INTERRUPT CONTROLLER
			     C	;	EQU	0FF20H			;VECTOR REGISTER
			     C	;	EQU	0FF22H			;END OF INTERRUPT
			     C	;	EQU	0FF24H			;POLL REGISTER
			     C	;	EQU	0FF26H			;POLL STATUS
			     C	;	EQU	0FF28H			;MASK REGISTER
			     C	;	EQU	0FF2AH			;PRIORITY
			     C	;	EQU	0FF2CH			;IN SERVICE
			     C	;	EQU	0FF2EH			;INTERRUPT REQUEST
			     C	;	EQU	0FF30H			;CONTROLLER STATUS
			     C	;	EQU	0FF32H			;TIMER CONTROL
			     C	;	EQU	0FF34H			;DMA CHANNEL 0
			     C	;	EQU	0FF36H			;DMA CHANNEL 1
			     C	;	EQU	0FF38H			;INTERRUPT 0
			     C	;	EQU	0FF3AH			;INTERRUPT 1
			     C	;	EQU	0FF3CH			;INTERRUPT 2
			     C	;	EQU	0FF3EH			;INTERRUPT 3
			     C	; TIMER 0 - INPUT CLOCK FOR 825O.
			     C	;	EQU	0FF50H			;COUNT
 = FF52 		     C	ICBTMA0 EQU	0FF52H			;MAXIMUM COUNT A
			     C	;	EQU	0FF54H			;MAXIMUM COUNT B
 = FF56 		     C	ICBTMD0 EQU	0FF56H			;MODE
			     C	; TIMER 1
			     C	;	EQU	0FF58H			;COUNT
			     C	;	EQU	0FF5AH			;MAXIMUM COUNT A
			     C	;	EQU	0FF5CH			;MAXIMUM COUNT B
			     C	;	EQU	0FF5EH			;MODE
			     C	; TIMER 2
			     C	;	EQU	0FF60H			;COUNT
			     C	;	EQU	0FF62H			;MAXIMUM COUNT A
			     C	;	EQU	0FF66H			;MODE
			     C	; MEMORY CHIP SELECTS
			     C	;	EQU	0FFA0H			;UPPER MEMORY SELECT
			     C	;	EQU	0FFA2H			;LOWER MEMORY SELECT
			     C	;	EQU	0FFA8H			;MIDDLE MEMORY BLOCK SIZE
			     C	;	EQU	0FFA6H			;MIDDLE MEMORY BASE ADDRESS
			     C	;	EQU	0FFA4H			;I/O  PERIPHERAL ADDRESS CHIP SELECT
			     C	; DMA CHANNEL 0 - VIDEO SCROLLING
 = FFC0 		     C	ICBSPL0 EQU	0FFC0H			;SOURCE POINTER-LOW 16 BITS
 = FFC2 		     C	ICBSPH0 EQU	0FFC2H			;SOURCE POINTER-HIGH 4 BITS
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-2
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				POD - power on diagnostics

 = FFC4 		     C	ICBDPL0 EQU	0FFC4H			;DESTINATION POINTER-LOW 16 BITS
 = FFC6 		     C	ICBDPH0 EQU	0FFC6H			;DESTINATION POINTER-HIGH 4 BITS
 = FFC8 		     C	ICBCNT0 EQU	0FFC8H			;COUNT
 = FFCA 		     C	ICBCTL0 EQU	0FFCAH			;CONTROL
			     C	; DMA CHANNEL 1
			     C	;	EQU	0FFD0H			;SOURCE POINTER-LOW 16 BITS
			     C	;	EQU	0FFD2H			;SOURCE POINTER-HIGH 4 BITS
			     C	;	EQU	0FFD4H			;DESTINATION POINTER-LOW 16 BITS
			     C	;	EQU	0FFD6H			;DESTINATION POINTER-HIGH 4 BITS
			     C	;	EQU	0FFD8H			;COUNT
			     C	;	EQU	0FFDAH			;CONTROL
 = FFFE 		     C	ICBRRG	EQU	0FFFEH			;RELOCATION REGISTER
			     C	;------------------------------
			     C	; 8253 TIMER
 = 0040 		     C	COUNT0	EQU	40H			;REAL TIME CLOCK
 = 0041 		     C	COUNT1	EQU	41H			;MEMORY REFRESH
 = 0042 		     C	COUNT2	EQU	42H			;SPEAKER AND CASSETTE
 = 0043 		     C	TIMCTL	EQU	43H			;TIMER CONTROL
			     C	;-------------------
			     C	; 8250 ACE
 = 03F8 		     C	ACEDAT	EQU	3F8H			;DATA PORT
 = 03F9 		     C	ACEIEN	EQU	3F9H			;INTERRUPT ENABLE REGISTER
 = 03FA 		     C	ACEIID	EQU	3FAH			;INTERRUPT ID REGISTER
 = 03FB 		     C	ACELCT	EQU	3FBH			;LINE CONTROL REGISTER
 = 03FC 		     C	ACEMCT	EQU	3FCH			;MODEM CONTROL REGISTER
 = 03FD 		     C	ACELST	EQU	3FDH			;LINE STATUS REGISTER
 = 03FE 		     C	ACEMST	EQU	3FEH			;MODEM STATUS REGISTER
			     C	;--------------------
			     C	; 8250 AUXILIARY SERIAL PORT (PLUG-IN BOARD)
 = 02F8 		     C	AUXDAT	EQU	2F8H			;DATA PORT
 = 02F9 		     C	AUXIEN	EQU	2F9H			;INTERRUPT ENABLE REGISTER
 = 02FA 		     C	AUXIID	EQU	2FAH			;INTERRUPT ID REGISTER
 = 02FB 		     C	AUXLCT	EQU	2FBH			;LINE CONTROL REGISTER
 = 02FC 		     C	AUXMCT	EQU	2FCH			;MODEM CONTROL REGISTER
 = 02FD 		     C	AUXLST	EQU	2FDH			;LINE STATUS REGISTER
 = 02FE 		     C	AUXMST	EQU	2FEH			;MODEM STATUS REGISTER
			     C	;--------------------
			     C	; 8274 MULTI-PROTOCOL SERIAL CONTROLLER.
 = 02F8 		     C	MPSADAT EQU	2F8H			;CHANNEL A DATA PORT
 = 02FA 		     C	MPSASTA EQU	2FAH			;CHANNEL A STATUS PORT
 =			     C	MPSACTL EQU	MPSASTA 		;CHANNEL A CONTROL PORT
 = 02F9 		     C	MPSBDAT EQU	2F9H			;CHANNEL B DATA PORT
 = 02FB 		     C	MPSBSTA EQU	2FBH			;CHANNEL B STATUS PORT
 =			     C	MPSBCTL EQU	MPSBSTA 		;CHANNEL B CONTROL PORT
			     C	;--------------------
			     C	; 8259 PIC
 = 0020 		     C	PICPT0	EQU	20H			;PORT 0C0
 = 0021 		     C	PICPT2	EQU	21H			;PORT 0C2
			     C	;----------------------
			     C	; 6845 CRT CONTROLLER
 = 03B4 		     C	CRTIDX	EQU	3B4H			;INDEX REGISTER
 = 03B5 		     C	CRTDAT	EQU	3B5H			;DATA REGISTER
 = 03B8 		     C	CRTCTL	EQU	3B8H			;CONTROL PORT
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-3
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				POD - power on diagnostics

 = 03B9 		     C	CRTSEL	EQU	3B9H			;COLOR SELECTION PORT
 = 03BA 		     C	CRTSTA	EQU	3BAH			;STATUS PORT
 = 03BE 		     C	CRTMPT	EQU	3BEH			;MONOCHROME PORT
 = 03BF 		     C	CRTCPT	EQU	3BFH			;COLOR PORT
			     C	;---------------------
			     C	; 765 FLOPPY DISK CONTROLLER
 = 03F5 		     C	FDCDAT	EQU	3F5H			;DATA
 = 03F4 		     C	FDCSTA	EQU	3F4H			;STATUS
			     C	;---------------------
			     C	; 8237 DMA CONTROLLER
			     C	; ADDRESS AND COUNT REGISTERS: READ/WRITE 2 BYTES--LSB FIRST
			     C	; MEMORY REFRESH CHANNEL
 = 0000 		     C	DMAAD0	EQU	00H			;ADDRESS REGISTER CHANNEL 0
 = 0001 		     C	DMACT0	EQU	01H			;COUNT REGISTER CHANNEL 0
			     C	;
 = 0002 		     C	DMAAD1	EQU	02H			;ADDRESS REGISTER CHANNEL 1
 = 0003 		     C	DMACT1	EQU	03H			;COUNT REGISTER CHANNEL 1
			     C	; MINI-FLOPPY CHANNEL
 = 0004 		     C	DMAAD2	EQU	04H			;ADDRESS REGISTER CHANNEL 2
 = 0005 		     C	DMACT2	EQU	05H			;COUNT REGISTER CHANNEL 2
			     C	; HARD DISK CHANNEL
 = 0006 		     C	DMAAD3	EQU	06H			;ADDRESS REGISTER CHANNEL 3
 = 0007 		     C	DMACT3	EQU	07H			;COUNT REGISTER CHANNEL 3
 = 0008 		     C	DMA3_DONE	equ 00001000b	;channel 3 dma done
			     C	; OTHER DMA REGISTERS
 = 0008 		     C	DMACMD	EQU	08H			;COMMAND REGISTER
 = 000A 		     C	DMAMSK	EQU	0AH			;SET/RESET MASK REGISTER
 = 000B 		     C	DMAMOD	EQU	0BH			;MODE REGISTER
 = 000C 		     C	DMABFF	EQU	0CH			;BYTE POINTER FLIP/FLOP
 = 000D 		     C	DMATMP	EQU	0DH			;TEMPORARY REGISTER
 = 0083 		     C	DMAPAG	EQU	83H			;BASE PAGE REGISTER
 = 0081 		     C	DMAHOR	EQU	81H			;HIGH ORDER BITS REGISTER (FLOPPY)
 = 0082 		     C	DMAHOR3 EQU	82H			;HIGH ORDER BITS REGISTER (HARD DISK)
			     C
			     C	;------------------------
			     C	; 8255 PARALLEL PORT FOR INTERNAL USAGE
			     C	;------------------------
 = 0060 		     C	PARPTA	EQU	60H			;PARALLEL PORT 'A'
 = 0061 		     C	PARPTB	EQU	61H			;PARALLEL PORT 'B'
 = 0062 		     C	PARPTC	EQU	62H			;PARALLEL PORT 'C'
 = 0063 		     C	PARCTL	EQU	63H			;PARALLEL CONTROL
			     C	;--------------------------
			     C	; PARALLELL PRINTER PORT
 = 03BC 		     C	PRTDAT	EQU	3BCH			;PRINTER DATA
 = 03BD 		     C	PRTSTA	EQU	3BDH			;PRINTER STATUS
 = 03BE 		     C	PRTCTL	EQU	3BEH			;PRINTER CONTROL
			     C	;--------------------------
			     C	; OKI MSM58321RS CALENDAR/CLOCK
 = 03BC 		     C	CALDAT	EQU	3BCH			;DATA PORT
 = 03BD 		     C	CALCTL	EQU	3BDH			;CONTROL PORT
 = 03BE 		     C	CALINP	EQU	3BEH			;INPUT LATCH
			     C	;------------------------------
			     C	; NON-MASKABLE INTERRUPT REGISTER
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-4
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				POD - power on diagnostics

 = 00A0 		     C	NMIREG	EQU	0A0H
			     C	;-------------------------------------------------------------------
			     C	; CONSTANTS USED FOR HARDWARE INITIALIZATION
			     C	;-------------------------------------------------------------------
			     C	; 8253 TIMER
 = 0000 		     C	TNUM0	EQU	0*40H			;TIMER NO. 0
 = 0040 		     C	TNUM1	EQU	1*40H			;TIMER NO. 1
 = 0080 		     C	TNUM2	EQU	2*40H			;TIMER NO. 2
 = 0000 		     C	TMOD0	EQU	0*2			;MODE 0-INTERRUPT ON TERMINAL COUNT
 = 0002 		     C	TMOD1	EQU	1*2			;MODE 1-PROGRAMMABLE ONE-SHOT
 = 0004 		     C	TMOD2	EQU	2*2			;MODE 2-RATE GENERATOR
 = 0006 		     C	TMOD3	EQU	3*2			;MODE 3-SQUARE WAVE GENERATOR
 = 0010 		     C	TLSB	EQU	1*10H			;READ/LOAD LEAST SIGNIF BYTE ONLY
 = 0020 		     C	TMSB	EQU	2*10H			;READ/LOAD MOST SIGNIFICANT BYTE ONLY
 = 0030 		     C	TLSMSB	EQU	3*10H			;READ/LOAD LSB AND THEN MSB
			     C	;--------------------------------
			     C	; 80186 INTERNAL TIMER CONTROL BITS
 = 0001 		     C	CONT	EQU	1			;RUN CONTINUOUSLY
 = 0002 		     C	ALT	EQU	2			;ALTERNATE A/B COUNTS
 = 0004 		     C	EXT	EQU	4			;EXTERNAL CLOCKING
 = 2000 		     C	INT	EQU	2000H			;INTERRUPT ENABLE
 = 4000 		     C	INH	EQU	4000H			;INHIBIT
 = 8000 		     C	EN	EQU	8000H			;ENABLE
			     C	;----------------------------------
			     C	; 8250 ACE
 = 0001 		     C	DR	EQU	1			;ACE DATA READY
 = 0020 		     C	THRE	EQU	20H			;ACE TRANSMIT HOLDING REGISTER EMPTY
			     C	;------------------------------
			     C	; 8237 DMA CONTROLLER
 = 0040 		     C	DSINGLE EQU	40H			;SINGLE TRANSFER MODE
 = 0010 		     C	DAUTO	EQU	10H			;AUTO INITIALIZATION
 = 0008 		     C	DREAD	EQU	8			;READ TRANSFER
 = 0004 		     C	DWRITE	EQU	4			;WRITE TRANSFER
			     C	;---------------------------------
			     C	; 8259 PIC
			     C	; INTERRUPT MASK BITS.
			     C	; MUST BE REVERSED BEFORE SENDING TO THE 8259 PIC PORT 2.
 = 0001 		     C	RTCMSK	EQU	01H			;REAL TIME CLOCK
 = 0002 		     C	KBDMSK	EQU	02H			;KEYBOARD
 = 0004 		     C	RESMSK	EQU	04H			;RESERVED
 = 0010 		     C	AINMSK	EQU	10H			;ACE INPUT MASK (8250)
 = 0020 		     C	TMPMSK	EQU	20H			;TEMPORARY AUXILIARY INPUT 8088
 = 0040 		     C	FLPMSK	EQU	40H			;FLOPPY MASK
 = 0080 		     C	PTRMSK	EQU	80H			;PRINTER OR AUXILIARY MASK
			     C	;----------------------------------
			     C	; 765 FLOPPY DISK CONTROLLER
			     C	; COMMANDS
 = 0006 		     C	FDRD	EQU	06H			;READ
 = 0005 		     C	FDWR	EQU	05H			;WRITE
 = 000D 		     C	FDFMT	EQU	0DH			;FORMAT
 = 0007 		     C	FDREC	EQU	07H			;RECALIBRATE
 = 0008 		     C	FDSENS	EQU	08H			;SENSE STATUS
 = 0003 		     C	FDSPEC	EQU	03H			;SPECIFY
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-5
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				POD - power on diagnostics

 = 0004 		     C	FDDRV	EQU	04H			;SENSE DRIVE STATUS
 = 000F 		     C	FDSEEK	EQU	0FH			;SEEK
			     C	; MODIFIER BITS
 = 0000 		     C	FM	EQU	00H			;SINGLE DENSITY
 = 0040 		     C	MFM	EQU	40H			;DOUBLE DENSITY
 = 0020 		     C	SK	EQU	20H			;SKIP DELETED DATA ADDRESS MARK
 = 0080 		     C	MT	EQU	80H			;MULTI-TRACK OPERATION
			     C	; MODIFIED COMMANDS
 = 00E6 		     C	DDFDRD	EQU	MFM+FDRD+SK+MT		;DOUBLE DENSITY FLOPPY READ
 = 00C5 		     C	DDFDWR	EQU	MFM+FDWR+MT		;DOUBLE DENSITY FLOPPY WRITE
			     C	; CONSTANTS FOR MFM (DOUBLE DENSITY)
			     C	; CONSTANTS ARE BASED ON A 4MHZ CLOCK.
			     C	; FAST STEPPING RATE FOR SHUGART. SLOW STEPPING RATE FOR ALL OTHERS.
 = 000D 		     C	FSRT	EQU	0DH			;FAST=0D=3MS*2=6MS.
 = 0006 		     C	SSRT	EQU	06H			;SLOW=06=10MS*2=20MS.
 = 000F 		     C	HUT	EQU	0FH			;HEAD UNLOAD TIME*32MS=480MS
 = 0007 		     C	HLT	EQU	07H			;HEAD LOAD TIME*4MS=28MS
 = 002A 		     C	GPLDD	EQU	2AH			;GAP LENGTH (DOUBLE DENSITY)
 = 00FF 		     C	DTL	EQU	0FFH			;DATA LENGTH
 = 0050 		     C	GPLFMT	EQU	50H			;GAP LENGTH FOR FORMATTING
 = 00E5 		     C	DFC	EQU	0E5H			;FILL CHARACTER FOR TRACK FORMATTING
 = 0019 		     C	HST	EQU	25			;HEAD SETTLE TIME=25MS
 = 0004 		     C	MST	EQU	4			;MOTOR START TIME*1/8S=1/2S
			     C	; STATUS BITS
 = 0080 		     C	RQM	EQU	80H			;FDC REQUESTING READ OR WRITE
 = 0040 		     C	DIO	EQU	40H			;1=READ FDC    0=WRITE FDC
 = 0010 		     C	FDCBSY	EQU	10H			;FD CONTROLLER BUSY
			     C	;---------------------------------
			     C	; 8255 PARALELL PORT FOR INTERNAL USAGE
			     C	; FOLLOWING ARE THE BITS USAGE FOR PORT 'B'. ALL OUTPUTS.
 = 0080 		     C	KBDDIS	EQU	80H			;KEYBOARD DISABLE + CLEAR INT REQUEST
			     C	; NOTE: THE OPPOSITE OF KEYBOARD DISABLE IS READ DIP SWITCHES 1 OR 2.
 = 0040 		     C	KBDCLK	EQU	40H			;KEYBOARD CLOCK ENABLE
 = 0008 		     C	FLPOFF	EQU	08H			;FLOPPY MOTORS OFF
			     C	;--------------------
			     C	; PORT 'C' HAS BEEN DIVIDED INTO 2 GROUPS OF 4 LINES EACH.
			     C	; THE LOWER PART ARE ALL OUTPUTS.
			     C	; PCO	NOT USED.
			     C	; PC1	NOT USED.
			     C	; PC2	5.25 IN. MINI-FLOPPIES BEING USED.
			     C	; PC3	FLOPPY DISK CONTROLLER RESET.
			     C	; THE UPPER PART ARE ALL INPUTS.
			     C	; PC4	CALENDAR/CLOCK CHIP NOT BUSY. (RD/WR ALLOWED).
			     C	; PC5	SPEAKER OR DATA SET READY.
			     C	; PC6	I/O PARITY CHECK.
			     C	; PC7	MEMORY PARITY CHECK.
			     C	;----------------------------------
			     C	; OKI MSM58321RS CALENDAR/CLOCK
			     C	; CALENDAR CONTROL BITS
 = 0001 		     C	CWRITE	EQU	1			;DATA WRITE
 = 0002 		     C	CREAD	EQU	2			;DATA READ
 = 0004 		     C	CSELECT EQU	4			;CHIP SELECT
			     C	;CSTOP	EQU	8			;STOP
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-6
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				POD - power on diagnostics

 = 0010 		     C	CADDRW	EQU	10H			;ADDRESS WRITE
			     C	;CTEST	EQU	20H			;TEST
			     C	;	EQU	40H			;NOT USED
 = 0080 		     C	CINPUT	EQU	80H			;INPUT
			     C	;---------------------------------
			     C
			     C	;	Equates for GOUPIL4 Low Level Hard Disk Driver (INT 13h)
			     C
 = 0080 		     C	HD_CHANGED	equ 10000000b		;flag bit masks
 = 0040 		     C	HD_PENDING	equ 01000000b
 = 0020 		     C	HD_BUSY 	equ 00100000b
 = 0040 		     C	Z_flag		equ 0000000001000000b	;zero flag bit position
 = 0001 		     C	CY_flag 	equ 0000000000000001b	;carry flag bit position
			     C	;	functions are defined by the value in ah:
 = 0000 		     C	reset_cmd	equ 0;	    controller reset
 = 0001 		     C	stat_cmd	equ 1;	    read stat of last operation
 = 0002 		     C	read_cmd	equ 2;	    read sector(s)
 = 0003 		     C	write_cmd	equ 3;	    write sector(s)
 = 0004 		     C	verify_cmd	equ 4;	    verify sector(s)
 = 0005 		     C	formt_cmd	equ 5;	    format track
 = 0006 		     C	formbt_cmd	equ 6;	    format track with bad sector flag
 = 0007 		     C	formd_cmd	equ 7;	    format drive (starting at track)
 = 0008 		     C	parms_cmd	equ 8;	    return drive parms
 = 0009 		     C	initchr_cmd	equ 9;	    set drive characteristics
 = 000A 		     C	readl_cmd	equ 10;A    read long (ECC)
 = 000B 		     C	writel_cmd	equ 11;B    write long (ECC)
 = 000C 		     C	seek_cmd	equ 12;C    seek
 = 000D 		     C	xreset_cmd	equ 13;D    reset
 = 000E 		     C	readb_cmd	equ 14;E    read buffer
 = 000F 		     C	writeb_cmd	equ 15;F    write buffer
 = 0010 		     C	rdy_cmd 	equ 16;10   drive ready?
 = 0011 		     C	recal_cmd	equ 17;11   recal
 = 0012 		     C	rdiag_cmd	equ 18;12   RAM diag
 = 0013 		     C	ddiag_cmd	equ 19;13   drive diag
 = 0014 		     C	cdiag_cmd	equ 20;14   controller diag
			     C
			     C	;	Other Parms:
			     C
			     C	;	al	sector count
			     C	;	es:bx	buffer address
			     C	;	ch	cyl low
			     C	;	cl	sector (1-17) and two bits cyl hi (7,6)
			     C	;	dh	head
			     C	;	dl	drive (80-87) bit 7 indicates hard disk
			     C
			     C	;	returns
			     C
			     C	;	carry flag set if op failed, reset if ok
			     C	;	ah	return status as below:
 = 0001 		     C	cmd_hderr	equ 1
 = 0002 		     C	addr_mark_hderr equ 2
 = 0004 		     C	not_fnd_hderr	equ 4
 = 0005 		     C	reset_hderr	equ 5
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-7
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				POD - power on diagnostics

 = 0007 		     C	init_hderr	equ 7
 = 0009 		     C	dma_hderr	equ 9		;dma boundry error
 = 000B 		     C	track_hderr	equ 11
 = 0011 		     C	ecc_ok_hderr	equ 17		;ecc corrected data
 = 0010 		     C	ecc_hderr	equ 16
 = 0020 		     C	cntrlr_hderr	equ 32
 = 0040 		     C	seek_hderr	equ 64
 = 0080 		     C	timeout_hderr	equ 128
 = 00FF 		     C	sense_hderr	equ 0ffh
 = 00BB 		     C	gen_hderr	equ 0bbh	;generalized error
 = 00CC 		     C	rdy_hderr	equ 0cch	;special not ready for get_change_status req
			     C
			     C	;	interrupt equates
 = 000D 		     C	cntrlr_int	equ 0dh 	;hardware int from controller (IRQ5)
 = 0013 		     C	disk_int	equ 13h
 = 0019 		     C	boot_int	equ 19h
 = 001A 		     C	timer_int	equ 1ah 	;1/18 sec timer values
 = 001E 		     C	diskette_parms	equ 1eh 	;pointer to oddball diskette parms
 = 0040 		     C	diskette_int	equ 40h
 = 0041 		     C	hd_parms	equ 41h 	;pointer to hd characteristics
 = 0021 		     C	int_mask_port	equ 21h 	;interrupt chip mask port (hi is disabled)
			     C
			     C	;	xebec specific equates
 = 0320 		     C	xebec_port	equ 320h	;base address of xebec controller
 = 0001 		     C	rq_bit		equ 00000001b	;request bit
 = 0002 		     C	io_bit		equ 00000010b	;input+/output- bit
 = 0004 		     C	cd_bit		equ 00000100b	;command+/data- bit
 = 0008 		     C	busy_bit	equ 00001000b	;controller busy
			     C	;	xebec command codes
 = 0000 		     C	rdy_xcmd	equ 0		;test controller/drive ready
 = 0001 		     C	recal_xcmd	equ 1
 = 0003 		     C	RSS_xcmd	equ 3		;request sense status
 = 0004 		     C	form_drv_xcmd	equ 4
 = 0005 		     C	verify_xcmd	equ 5
 = 0006 		     C	form_trk_xcmd	equ 6		;recal, then format single track
 = 0007 		     C	form_btrk_xcmd	equ 7		;recal, format track with BADTRACK ID
 = 0008 		     C	read_xcmd	equ 8
 = 000A 		     C	write_xcmd	equ 10
 = 000B 		     C	seek_xcmd	equ 11
 = 000C 		     C	init_char_xcmd	equ 12		;init drive characteristics from hd_parms
 = 000D 		     C	err_len_xcmd	equ 13		;read error length (in bits) after ECC
