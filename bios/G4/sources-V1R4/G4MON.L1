				HD - hard disk interface

 05CD  8B 46 0A 			mov ax,bp_cnt[bp]	;is count at zero?
 05D0  0A C4				or al,ah
 05D2  0A 46 0D 			or al,bp_cnthor[bp]	;see if any bits are set
 05D5  74 0B				jz wl_20		;if all zero, no more to do
 05D7  53				push bx 		;save counters
 05D8  51				push cx
 05D9  E8 050A R			call prg_dma		;re-program dma
 05DC  B0 03				mov al,3		;send dma go
 05DE  E6 0A				out DMAMSK,al
 05E0  59				pop cx
 05E1  5B				pop bx
 05E2				wl_20:
 05E2  E2 C8				loop wait_loop
 05E4  4B				dec bx
 05E5  75 C5				jnz wait_loop		;go till bx hits 0
 05E7  B0 80				mov al,timeout_hderr
 05E9  E9 043E R			jmp set_status

 05EC				get_dat_port:		;data port = 0
 05EC  BA 0320				mov dx,xebec_port	;base address for all xebec boards
 05EF  02 56 0F 			add dl,bp_hd_port[bp]	;add offset for this board
 05F2  80 D6 00 			adc dh,0		;if carry, add to upper byte
 05F5  C3				ret
 05F6				get_stat_port:		;status/reset port = 1
 05F6  E8 05EC R			call get_dat_port
 05F9  42				inc dx
 05FA  C3				ret
 05FB				get_sel_port:		;controller select port = 2
 05FB  E8 05F6 R			call get_stat_port
 05FE  42				inc dx
 05FF  C3				ret
 0600				get_reg_port:		;interrupt and DMA register port = 3
 0600  E8 05FB R			call get_sel_port
 0603  42				inc dx
 0604  C3				ret

 0605				getparmptr:		;get pointer to parm table in es:bx
 0605  52				push dx
 0606  51				push cx
 0607  50				push ax
					assume es:data
 0608  33 C0				xor ax,ax		;get es to segment 0 (interrupt table)
 060A  8E C0				mov es,ax
