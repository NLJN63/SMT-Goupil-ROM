					subttl	INITDEV - initialize device drivers

				;;CHANGES
				;	date	release name, discription

					public init_drvrs

 0000				code segment public byte
					assume cs:code

				;************************************************************************
				;*
				;*			dev_tbl
				;*		Table of initialization offsets for device drivers.
				;*
				;************************************************************************

 0000				dev_tbl 	label	word
 0000  DF00			rompar		dw	0df00h		;parallel printer driver
 0002  E600			romser		dw	0e600h		;serial interface driver
 0004  E740			romkb		dw	0e740h		;keyboard h/w and s/w interface
 0006  EC40			romfd		dw	0ec40h		;floppy h/w, s/w and fd_parms
 0008  F030			romcrt		dw	0f030h		;video interface
 000A  F9C0			romtod		dw	0f9c0h		;time of day and char set
 = 000C 			dev_tbl_len	equ	$ - dev_tbl

				;************************************************************************
				;*
				;*			Init_drvrs (public)
				;*
				;*		Call each drivers initialization code
				;*		The binary image of each file is linked at an
				;*		absolute location, and the initialization code is
				;*		the first thing at that location.  So use the binary link
				;*		offsets as the initialization offsets.
				;*		Make sure that changes to the binary link are reflected here!!
				;*
				;************************************************************************

 000C				init_drvrs:
 000C  BE 0000 R			mov si,offset dev_tbl	;get offset of table
 000F  B9 0006				mov cx,dev_tbl_len/2	;number of entries in table
 0012				id_loop:
 0012  51				push cx 		;save loop counter
 0013  56				push si 		;save table pointer

 0014  2E: FF 14			call code:[si]		;get table entry

 0017  5E				pop si			;restore regs
 0018  59				pop cx
 0019  46				inc si			;move pointer to next entry
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-2
GOUPIL4 PC compatible Rom I/O System				08-02-85
				INITDEV - initialize device drivers

 001A  46				inc si
 001B  E2 F5				loop id_loop		;continue til end of table
 001D  C3				ret
 001E				code	ends
					end
