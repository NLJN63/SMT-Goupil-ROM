				;************************************************************************
				;*									*
				;*		FD_ByteIn  (local)					*
				;*									*
				;************************************************************************
				;*									*
				;*	get status data byte from FDC					*
				;*									*
				;*	ENTRY:	(none)							*
				;*	EXIT:	PSW.C set:    handshake error				*
				;*		PSW.C clear:  AL= status data byte from FDC		*
				;*		PSW.Z set:    last status byte available from FDC.	*
				;*									*
				;*	MODIFIES:   All GP registers					*
				;*									*
				;************************************************************************
 EF98				FD_ByteIn:
					clr	cx
 EF98  33 C9		      + 	xor	cx,cx
 EF9A				bi_05:				;-------- wait for RQM
 EF9A  BA 03F4				mov	dx,03F4h
 EF9D  EC				in	al,dx
 EF9E  A8 80				test	al,080h
 EFA0  75 06				jne	bi_10

 EFA2  E2 F6				loop	bi_05
 EFA4  B0 80				mov	al, FD_ERR_TO		; return Timeout
 EFA6				bi_err:
 EFA6  F9				stc				; return timeout
 EFA7  C3				ret
 EFA8				bi_10:				;-------- check for input direction
 EFA8  EC				in	al,dx
 EFA9  A8 40				test	al,040h
 EFAB  B0 20				mov	al, FD_ERR_FDC		; return bad FDC error
 EFAD  74 F7				je	bi_err			; handshake error

 EFAF  42				inc	dx		;-------- get status data byte from FDC
 EFB0  EC				in	al, dx
 EFB1  8A E0				mov	ah,al
									; pause
 EFB3  B9 0014				mov	cx,20
 EFB6				bi_20:
 EFB6  E2 FE				loop	bi_20
								;-------- check for FDC read pending
 EFB8  4A				dec	dx
 EFB9  EC				in	al, dx
 EFBA  86 C4				xchg	al,ah			; put data in AL
 EFBC  F6 C4 10 			test	ah, 010h		; set PSW.Z

 EFBF  F8				clc				; no error
 EFC0  C3				ret

 The Microsoft MACRO Assembler , Version 1.27 		Page	1-29
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMFD - floppy driver

				   page
				;************************************************************************
				;*									*
				;*		PC org'd floppy disk parms				*
				;*									*
				;************************************************************************

					morg	0efc7h
 EFC7			      + 	org 0efc7h

 EFC7  CF			fd_parms	db 0cfh 	;first two bytes are specfy bytes to NEC
 EFC8  02					db 2		;dma mode, head load time = 1
 EFC9  24					db 18 * 2	;two seconds worth of tic ints
 EFCA  02					db 2		;512 bytes per sector
 EFCB  09					db 9		;sectors per track
 EFCC  2A					db 02ah 	;gap
 EFCD  FF					db 0ffh 	;dtl
 EFCE  50					db 050h 	;format gap length
 EFCF  F6					db 0f6h 	;fill byte for formats
 EFD0  19					db 25		;head settling time (millisecs)
 EFD1  04					db 4		;motor start time (1/8 seconds)
 =				flop_parms_len	equ offset $ - offset flop_parms

 The Microsoft MACRO Assembler , Version 1.27 		Page	1-30
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMFD - floppy driver

				  page
				;************************************************************************
				;*									*
				;*		wait_rdy (local)					*
				;*									*
				;************************************************************************
				;*									*
				;*	Wait for flag from interrupt routine with timeout.		*
				;*									*
				;*	ENTRY:	DS = RDP segment					*
				;*		BP= new stack pointer on error				*
				;*									*
				;*	EXIT:	No error:	  Normal return.			*
				;*		Error condition:  terminate command			*
				;*				  AL= error type			*
				;*				  FD_Status(0-6)= FDC status result.	*
				;*									*
				;*	MODIFIES:	RDP:FD_Status(0-6)				*
				;*			only ES & SI preserved				*
				;*									*
				;************************************************************************
 EFD2				wait_rdy:
 EFD2  B0 08				mov	al,2*4			; wait 2 seconds
					clr	cx
 EFD4  33 C9		      + 	xor	cx,cx
					even
 EFD6				wr_10:
 EFD6  F6 06 0000 E 80			test	FD_Seek, FD_INT_BIT	; check for interrupt done
 EFDB  75 0B				jne	wr_20

 EFDD  E2 F7				loop	wr_10
 EFDF  FE C8				dec	al
 EFE1  75 F3				jnz	wr_10

 EFE3  B0 80				mov	al, FD_ERR_TO		; time out error
 EFE5  E9 ECEC R			jmp	f_exit
 EFE8				wr_20:
 EFE8  80 26 0000 E 7F			and	FD_Seek, not FD_INT_BIT ; clear interrupt flag
 EFED  C3				ret

 The Microsoft MACRO Assembler , Version 1.27 		Page	1-31
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMFD - floppy driver

				 page
				;************************************************************************
				;*									*
				;*		FD_Reset  (local)					*
				;*									*
				;************************************************************************
				;*									*
				;*	Floppy disk Controller reset					*
				;*									*
				;*	ENTRY:	(none)							*
				;*	EXIT:	(none)
				;*									*
				;*	MODIFIES:   All GP registers					*
				;*									*
				;************************************************************************

 EFEE				FD_Reset:
 EFEE  FA				cli				;*no interrupts during reset
 EFEF  8A 1E 0000 E			mov	bl, FD_Motor
 EFF3  81 E3 000F			and	bx, +0Fh
 EFF7  2E: 8A 87 EC74 R 		mov	al, reset_bits[bx]

 EFFC  BA 03F2				mov	dx, 03F2h		; reset controler
 EFFF  EE				out	dx, al

 F000  C6 06 0000 E 00			mov	FD_Seek, 0		; and seek status

 F005  B9 0014				mov	cx, 20
 F008				fr_10:
 F008  E2 FE				loop	fr_10

 F00A  0C 04				or	al, 4			; turn off reset
 F00C  EE				out	dx, al
 F00D  FB				sti
 F00E  C3				ret

 F00F				code	ends
					end
