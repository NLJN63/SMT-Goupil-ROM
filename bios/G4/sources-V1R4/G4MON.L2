				;************************************************************************
				;*									*
				;*		DEV_Init (public)					*
				;*									*
				;************************************************************************
				;*									*
				;*	Floppy disk Rios Initialization 				*
				;*									*
				;*	ENTRY:	none							*
				;*									*
				;*	EXIT:	none							*
				;*									*
				;*	MODIFIES:   All GP registers					*
				;*									*
				;************************************************************************
 EC84				Dev_Init:
 EC84  1E				push	ds
				Dseg	IVT using ax
 EC85  B8 ---- R	      + 	mov	ax, IVT
 EC88  8E D8		      + 	mov	ds, ax
					assume	ds:IVT

 EC8A  9C				pushf				; no interrupts allowed
 EC8B  FA				cli

 EC8C  C7 06 004C EC59 R		mov	IVT:[13h*4].LW, offset Cgroup:FD_RIOS_entry	; FD RIOS entry
 EC92  8C 0E 004E			mov	IVT:[13h*4].HW, cs

 EC96  C7 06 0038 EF57 R		mov	IVT:[0Eh*4].LW, offset Cgroup:FD_IRQ	; FD Interrupt entry
 EC9C  8C 0E 003A			mov	IVT:[0Eh*4].HW, cs

 ECA0  C7 06 0078 EFC7 R		mov	IVT:[1Eh*4].LW, offset Cgroup:FD_Parms	; FD parameter table
 ECA6  8C 0E 007A			mov	IVT:[1Eh*4].HW, cs

 ECAA  9D				popf				; restore interrupt state

				Dseg	RDP using ax
 ECAB  B8 ---- R	      + 	mov	ax, RDP
 ECAE  8E D8		      + 	mov	ds, ax
					assume	ds:RDP
					clr	ax
 ECB0  33 C0		      + 	xor	ax,ax
 ECB2  A2 0000 E			mov	FD_Seek,al
 ECB5  A2 0000 E			mov	FD_Result,al
 ECB8  A2 0000 E			mov	FD_Motor, al

 ECBB  2E: A0 EFC9 R			mov	al,Cgroup:FD_Parms.fd_mwait	; reset motor wait time
 ECBF  A2 0000 E			mov	FD_Timeout,al

 ECC2  1F				pop	ds
					assume	ds:nothing
 ECC3  C3				ret
