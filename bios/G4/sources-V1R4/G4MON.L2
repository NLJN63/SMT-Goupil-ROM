 F1E7  B0 30				mov	al,30h			;standard setting
 F1E9  80 3E 0000 E 06			cmp	crt_mode,6		;check if hi-res
 F1EE  75 02				jne	setmod5
 F1F0  B0 3F				mov	al,3Fh			;use this for hi-res

 F1F2				setmod5:
 F1F2  42				inc	dx			;overscan reg port
 F1F3  EE				out	dx,al			;set the reg
 F1F4  A2 0000 E			mov	crt_palette,al		;save value

