				;************************************************************************
				;*									*
				;*		FD_ByteOut (local)					*
				;*									*
				;************************************************************************
				;*									*
				;*	put command data byte to FDC					*
				;*									*
				;*	ENTRY:	AL= command data byte					*
				;*									*
				;*	EXIT:	PSW.C set:    timeout error				*
				;*									*
				;*	MODIFIES:   All GP registers					*
				;*									*
				;************************************************************************
 EF76				FD_ByteOut:
 EF76  8A E0				mov	ah,al			; save data byte
 EF78  BA 03F4				mov	dx, 03F4h		; status port
					clr	cx
 EF7B  33 C9		      + 	xor	cx,cx
 EF7D				bo_10:				;-------- wait for output direction
 EF7D  EC				in	al,dx
 EF7E  A8 40				test	al, 040h
 EF80  74 04				je	bo_20
 EF82  E2 F9				loop	bo_10
 EF84				bo_err: 				; too long
 EF84  F9				stc				; return timeout error
 EF85  C3				ret
 EF86				bo_20:				;-------- wait for RQM
 EF86  33 C9				xor	cx,cx
 EF88				bo_21:
 EF88  EC				in	al,dx
 EF89  A8 80				test	al, 80h
 EF8B  75 04				jne	bo_30

 EF8D  E2 F9				loop	bo_21
 EF8F  EB F3				jmp	bo_err
 EF91				bo_30:				;-------- put data to FDC
 EF91  8A C4				mov	al,ah
 EF93  B2 F5				mov	dl, 0F5h
 EF95  EE				out	dx,al

 EF96  F8				clc				; return no error
 EF97  C3				ret

