				;************************************************************************
				;*									*
				;*		DEV_Init public 					*
				;*									*
				;************************************************************************
				;*									*
				;*	PC Keyboard driver initialization				*
				;*									*
				;*	ENTRY:	none							*
				;*	EXIT:	none							*
				;*									*
				;*	MODIFIES:	Interrupt Vector at 0:68h			*
				;*			All GP registers				*
				;*									*
				;************************************************************************

 F9C0				Dev_Init:
 F9C0  9C				pushf				; no interrupts allowed
 F9C1  FA				cli

 F9C2  1E				push	ds			; DS is used
				Dseg	IVT using ax
 F9C3  B8 ---- R	      + 	mov	ax, IVT
 F9C6  8E D8		      + 	mov	ds, ax

				;------ set up related IVT's ---------

 F9C8  C7 06 0068 FE6E R		mov	IVT:[1Ah*4].LW, offset Cgroup:TOD_RIOS_entry ; TOD RIOS entry
 F9CE  8C 0E 006A			mov	IVT:[1Ah*4].HW, cs

 F9D2  C7 06 0020 FEA5 R		mov	IVT:[08h*4].LW, offset Cgroup:interval_timer ; interval timer
 F9D8  8C 0E 0022			mov	IVT:[08h*4].HW, cs

				    set_RDP	ax
 F9DC  B8 ---- R	      + 	mov	ax, RDP
 F9DF  8E D8		      + 	mov	ds, ax
					clr	ax
 F9E1  33 C0		      + 	xor	ax,ax
 F9E3  A3 0000 E			mov	Tmr_Counter.LW,ax
 F9E6  A3 0002 E			mov	Tmr_Counter.HW,ax
 F9E9  A2 0000 E			mov	Tmr_Overflow, al

 F9EC  1F				pop	ds
 F9ED  9D				popf				; restore interrupt state
 F9EE  C3				ret

