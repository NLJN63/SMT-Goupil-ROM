				;************************************************************************
				;*									*
				;*	PIXEL  --							*
				;*									*
				;************************************************************************

					assume	cs:Code, ds:RDP, es:nothing

 F8E2				PIXEL:


 F8E2				set_pixel:
 F8E2  E8 F911 R			call	pixaddr 		;get pixel address and mask
 F8E5  8A 46 00 			mov	al,[bp].RAL		;recover pixel to be written
 F8E8  A8 80				test	al,80h			;check if "xor" bit on
 F8EA  75 0F				jnz	xor_pixel

 F8EC  22 C4				and	al,ah			;mask non-significant bits
 F8EE  D3 E0				shl	ax,cl			;pos pixel and mask bits
 F8F0  F6 D4				not	ah			;clear old pixel from byte
 F8F2  26: 22 27			and	ah,es:[bx]
 F8F5  0A C4				or	al,ah			;set new pixel in byte
 F8F7  26: 88 07			mov	es:[bx],al		;and write back to screen
 F8FA  C3				ret

 F8FB				xor_pixel:
 F8FB  22 C4				and	al,ah			;mask non-significant bits
 F8FD  D2 E0				shl	al,cl			;position pixel bits
 F8FF  26: 30 07			xor	es:[bx],al		;xor them into screen
 F902  C3				ret

 F903				get_pixel:
 F903  E8 F911 R			call	pixaddr 		;get pixel address and mask
 F906  26: 8A 07			mov	al,es:[bx]		;read pixel byte
 F909  D2 E8				shr	al,cl			;right rustify pixel
 F90B  22 C4				and	al,ah			;isolate pixel bits
 F90D  88 46 00 			mov	[bp].RAL,al		;return pixel in AL
 F910  C3				ret



				; calc address and mask for pixel
				;
				;	entry:	DX = raster (0..199),
				;		CX = pixel  (0..319 or 0..639)
				;
				;	exit:	ES:BX = ptr to byte containing pixel
				;		CL = shift factor
				;		CH = pixel mask, right justified
				;		AX,DX destroyed.

 F911				pixaddr:
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-54
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

 F911  B8 B800				mov	ax,0B800h		;get screen base
 F914  8E C0				mov	es,ax

 F916  D1 EA				shr	dx,1			;calc raster offset
 F918  9C				pushf				;save psw.c (set if odd raster)
 F919  B0 50				mov	al,80			;addr of start of raster
 F91B  F6 E2				mul	dl
 F91D  9D				popf				;recall psw.c
 F91E  73 03				jnc	pix1			;skip if even raster
 F920  05 2000				add	ax,2000h		;bias offset for odd raster
 F923  8B D8			pix1:	mov	bx,ax

 F925  8B C1				mov	ax,cx			;get copy of pixel within raster
 F927  D1 E8				shr	ax,1			;start calc byte of raster
 F929  D1 E8				shr	ax,1
 F92B  F6 D1				not	cl

 F92D  80 3E 0000 E 06			cmp	crt_mode,6		;check if hi-res
 F932  74 0A				je	pix2

					;medium res: 2 bit pixels

 F934  03 D8				add	bx,ax			;es:bx = ptr to byte in screen
 F936  80 E1 03 			and	cl,3			;pixel pos within raster byte
 F939  D0 E1				shl	cl,1			;..by 2 bits
 F93B  B4 03				mov	ah,3
 F93D  C3				ret

					;high res: 1 bit pixels
 F93E				pix2:
 F93E  D1 E8				shr	ax,1			;one more time
 F940  03 D8				add	bx,ax			;es:bx = ptr to byte in screen
 F942  80 E1 07 			and	cl,7			;pixel pos within raster byte
 F945  B4 01				mov	ah,1

 F947  C3				ret

