				public	Dev_Init
				public	FD_RIOS_entry
				public	FD_Parms

				;************************************************************************
				;*									*
				;*		call here to initialize floppy driver			*
				;*		(must be first thing in module) 			*
				;*									*
				;************************************************************************

 EC40  EB 42 90 			jmp	Dev_Init	;initilialize this driver

