					;blank screen

 F1B3  8E C0				mov	es,ax			;es:di = addr of screen memory
 F1B5  33 FF				xor	di,di

 F1B7  BA B000				mov	dx,0B000h		;base addr of screen ram for mono
 F1BA  B8 0720				mov	ax,720h 		;blank char with std attrs
 F1BD  B9 0800				mov	cx,2048 		;words of monochrome screen ram
 F1C0  80 3E 0000 E 07			cmp	crt_mode,7		;check if monochrome
 F1C5  74 0F				je	setmod4

 F1C7  BA B800				mov	dx,0B800h		;base addr of screen ram for color
 F1CA  B9 2000				mov	cx,8192 		;words of color screen ram
 F1CD  80 3E 0000 E 04			cmp	crt_mode,4		;check if text mode
 F1D2  72 02				jb	setmod4
 F1D4  33 C0				xor	ax,ax			;graphics: fill screen with black

 F1D6				setmod4:
 F1D6  33 FF				xor	di,di			;es:di = ptr to screen ram
 F1D8  8E C2				mov	es,dx
 F1DA  F3/ AB				rep	stosw			;fill screen

					;enable video output

 F1DC  8B 16 0000 E			mov	dx,crt_iobase		;port address of video
 F1E0  83 C2 04 			add	dx,4			;control register
 F1E3  A0 0000 E			mov	al,crt_mode_reg 	;get new value of control reg
 F1E6  EE				out	dx,al			;set control reg

