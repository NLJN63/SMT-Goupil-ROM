				;************************************************************************
				;*									*
				;*		Local Data (in ROM)					*
				;*									*
				;************************************************************************
						; error list for status reg 1 bits
 EC5C  02 03 04 00		cmd_errs db	FD_ERR_HDR, FD_ERR_WP, FD_ERR_FIND, 0
 EC60  08 10 00 04			 db	FD_ERR_DMA, FD_ERR_CRC, 0, FD_ERR_FIND

						; parm tables for Read, Write, Verify, Format
 EC64  E6 C5 E6 4D		fdc_cmds db	0E6h, 0C5h, 0E6h, 04Dh	; controller commands
 EC68  46 4A 42 4A		dma_cmds db	046h, 04Ah, 042h, 04Ah	; dma direction commands
 EC6C  00 80 00 80		m_status db	0,    080h, 0,	  080h	; motor_status R/W flag

 EC70  01 02 04 08		bits		db	1,2,4,8

 EC74  08			reset_bits	db	00001000b	; all drives off
 EC75  18					db	00011000b	; drive 0 on
 EC76  29					db	00101001b	; drive 1 on
 EC77  39					db	00111001b	; drives 0 & 1 on

 EC78  4A					db	01001010b	; drive 2 on
 EC79  5A					db	01011010b	; drives 0 & 2 on
 EC7A  69					db	01101001b	; drives 1 & 2 on
 EC7B  79					db	01111001b	; drives 0, 1 & 2 on

 EC7C  8B					db	10001011b	; drive 3 on
 EC7D  9B					db	10011011b	; drives 0 & 3 on
 EC7E  A9					db	10101001b	; drives 1 & 3 on
 EC7F  B9					db	10111001b	; drives 0, 1 & 3 on

 EC80  CA					db	11001010b	; drives 2 & 3 on
 EC81  DA					db	11011010b	; drives 0, 2 & 3 on
 EC82  E9					db	11101001b	; drives 1, 2 & 3 on
 EC83  F9					db	11111001b	; drives 0, 1, 2 & 3 on

