			     C
 0000			     C	RDP	segment at 40h			; ROM Data Page
			     C
			     C	; system configuration
			     C
			     C	extrn	ser_base	: word		; base port addrs for serial comm
			     C	extrn	par_base	: word		; base port addrs for parallel
			     C
			     C	extrn	equip_vect	: word		; system equipment vector
			     C	extrn	top_memory	: word		; memory size, in 1K increments
			     C
			     C	; keyboard data
			     C
			     C	extrn	kb_state1	: byte		; keyboard current state
			     C	extrn	kb_state2	: byte		; more keyboard state
			     C	extrn	kb_keycode	: byte		; kb input via alted keypad
			     C
			     C	extrn	kb_head 	: word		; head ptr of keyboard buffer
			     C	extrn	kb_tail 	: word		; tail of keyboard buffer
			     C	extrn	kb_buffer	: word		; keyboard buffer area
			     C	extrn	kb_buff_last	: byte		; end of keyboard buffer
			     C
			     C	; diskette data
			     C
			     C	extrn	fd_seek 	: byte		; drive recalibration flags
			     C	extrn	fd_motor	: byte		; motor status
			     C	extrn	fd_timeout	: byte		; motor off timeout count
			     C
			     C	extrn	fd_result	: byte		; result code for previous operation
			     C	extrn	fd_status	: byte		; status bytes from floppy controller
			     C
			     C	; video display data
			     C
			     C	extrn	crt_mode	: byte		; current display mode
			     C	extrn	crt_cols	: word		; curr screen columns
			     C	extrn	crt_regen_leng	: word		; length of regen buffer, in bytes
			     C	extrn	crt_regen_base	: word		; base of regen buffer
			     C
			     C	extrn	crt_curs_pos	: word		; cursor locations for text pages
			     C	extrn	crt_curs_attrs	: word		; cursor attributes
			     C	extrn	crt_curr_page	: byte		; current display page
			     C
			     C	extrn	crt_iobase	: word		; crt controller port addr
			     C	extrn	crt_mode_reg	: byte		; copy of curr mode register setting
			     C	extrn	crt_palette	: byte		; copy of curr palette reg setting
			     C
			     C	; tod timer data
			     C
			     C	extrn	tmr_counter	: dword 	; timer tick counter
			     C	extrn	tmr_overflow	: byte		; 24 hour overflow
			     C
			     C	; system data area
			     C
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-5
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMFD - floppy driver

			     C	extrn	break_flag	: byte		; bit 7 set on break key event
			     C	extrn	reset_flag	: word		; set to 4147h on warm boot
			     C
			     C	; hard disk area
			     C
			     C	extrn	hd_status	: byte
			     C	extrn	n_drives	: byte
			     C	extrn	hd_flags	: byte
			     C	extrn	hd_cbits	: byte
			     C
			     C	; printer/serial data
			     C
			     C	extrn	par_timeout	: byte		; timeout for parallel ports
			     C	extrn	ser_timeout	: byte		; timeouts for rs232 ports
			     C
			     C	; auxilary keyboard data area
			     C
			     C	extrn	kb_buff_start	: word		; ptr to start of kb buffer
			     C	extrn	kb_buff_end	: word		; ptr to end of kb buffer
			     C
 0000			     C	RDP ends

 = 0001 			FD_ERR_CMD	equ	1		; bad FDC command or parm
 = 0002 			FD_ERR_HDR	equ	2		; no header address marker
 = 0003 			FD_ERR_WP	equ	3		; write protected
 = 0004 			FD_ERR_FIND	equ	4		; sector not found
 = 0008 			FD_ERR_DMA	equ	8		; faulty dma operation
 = 0009 			FD_ERR_64K	equ	9		; dma boundary error
 = 0010 			FD_ERR_CRC	equ	010h		; bad checksum
 = 0020 			FD_ERR_FDC	equ	020h		; controller failure
 = 0040 			FD_ERR_SEEK	equ	040h		; seek op failed
 = 0080 			FD_ERR_TO	equ	080h		; timeout error

 = 0080 			FD_INT_BIT	equ	080h		; interrupt ready flag for FD_Seek


				parms struc
 0000  ??			    fd_parm1	db	?
 0001  ??			    fd_parm2	db	?
 0002  ??			    fd_mwait	db	?
 0003  ??			    fd_secsize	db	?
 0004  ??			    fd_sectrk	db	?
 0005  ??			    fd_gap1	db	?
 0006  ??			    fd_dtl	db	?
 0007  ??			    fd_gap2	db	?
 0008  ??			    fd_fbyte	db	?
 0009  ??			    fd_hsettle	db	?
 000A  ??			    fd_start	db	?
 000B				parms ends

 0000				IVT	segment at 0
 0000				IVT	ends

