 F171  EB 0C 90 			jmp	setmod2a

 F174				setmod2:
 F174  BA 03BF				mov	dx,3bfh
 F177  B0 01				mov	al,1
 F179  EE				out	dx,al			;change 8Mhz HW from mono to color

 F17A  BA 03D4				mov	dx,3D4h 		;set for color adaptor
 F17D  FE C8				dec	al			;disable for color
 F17F				setmod2a:
 F17F  89 16 0000 E			mov	crt_iobase,dx		;disable video
 F183  83 C2 04 			add	dx,4			;control register port
 F186  EE				out	dx,al

					;set 6845 registers

 F187  8B 16 0000 E			mov	dx,crt_iobase		;get port address of 6845

 F18B  33 C0				xor	ax,ax			;get video params pointer
 F18D  8E D8				mov	ds,ax			;from int vector table
 F18F  C5 36 0074			lds	si,ds:dword ptr[4*PARMS_INT]
					assume	ds:nothing
 F193  58				pop	ax			;add in offset to values for mode
 F194  03 F0				add	si,ax

 F196  B4 00				mov	ah,0			;ah = curr crt register
 F198				setmod3:
 F198  8A C4				mov	al,ah			;select crt register
 F19A  EE				out	dx,al
 F19B  42				inc	dx
 F19C  AC				lodsb				;get next value
 F19D  EE				out	dx,al			;set register
 F19E  4A				dec	dx
 F19F  FE C4				inc	ah			;next register
 F1A1  80 FC 0F 			cmp	ah,15			;check if done
 F1A4  76 F2				jbe	setmod3

 F1A6  8B 44 FA 			mov	ax,[si-6]		;get cursor attrs
 F1A9  86 E0				xchg	ah,al
 F1AB  26: A3 0000 E			mov	es:crt_curs_attrs,ax	;and save them

 F1AF  8C C0				mov	ax,es			;restore ds
 F1B1  8E D8				mov	ds,ax
					assume	ds:RDP,es:nothing

