			     C	INCLUDE DEFINES.DEF
 = 0000 		     C	B		equ	byte ptr 0
 = 0000 		     C	W		equ	word ptr 0
 = 0000 		     C	P		equ	dword ptr 0
			     C
 = 0000 		     C	LB		equ	byte ptr 0
 = 0001 		     C	HB		equ	byte ptr 1
 = 0000 		     C	LW		equ	word ptr 0
 = 0002 		     C	HW		equ	word ptr 2
 = 0002 		     C	SEL		equ	word ptr 2
 = 0000 		     C	OFF		equ	word ptr 0
			     C
 = 0000 		     C	NULL		equ	0
 = 0000 		     C	FALSE		equ	0
 =-0001 		     C	TRUE		equ	(not false)
 = 0000 		     C	E_OK		equ	0
			     C	INCLUDE PC.DEF
