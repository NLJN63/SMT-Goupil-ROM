				;************************************************************************
				;*									*
				;*		get_status (local)					*
				;*									*
				;************************************************************************
				;*									*
				;*	GET STATUS result from previously sent command. 		*
				;*									*
				;*	ENTRY:	DS = RDP segment					*
				;*		BP= new stack pointer on error				*
				;*									*
				;*	EXIT:	No error:	  Normal return.			*
				;*		Error condition:  terminate command			*
				;*				  AL= error type			*
				;*				  FD_Status(0-6)= FDC status result	*
				;*									*
				;*	MODIFIES:	RDP:FD_Status(0-6)				*
				;*			only ES & SI preserved				*
				;*									*
				;************************************************************************
 EF06				get_status:
					clr	bx			; start index
 EF06  33 DB		      + 	xor	bx,bx
 EF08				gs_10:
 EF08  53				push	bx			; save index
 EF09  E8 EF98 R			call	FD_ByteIn		; get byte from FDC
 EF0C  5B				pop	bx
 EF0D  72 0D				jc	gs_30			; FDC handshake error

 EF0F  88 87 0000 E			mov	FD_Status[bx], al	; store result byte
 EF13  74 06				je	gs_20

 EF15  43				inc	bx
 EF16  83 FB 07 			cmp	bx, 7
 EF19  72 ED				jb	gs_10
 EF1B				gs_20:
 EF1B  C3				ret
 EF1C				gs_30:

 EF1C  E9 ECEC R			jmp	f_exit			; AL has error type

