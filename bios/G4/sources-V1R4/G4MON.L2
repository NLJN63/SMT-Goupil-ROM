 F6AE  57				push	di
 F6AF  AC				lodsb				;get next raster of character
 F6B0  FF D2				call	dx			;write to screen
 F6B2  5F				pop	di			;restore registers
 F6B3  59				pop	cx
 F6B4  51				push	cx			;save them again
 F6B5  57				push	di
 F6B6  81 C7 2000			add	di,2000h		;do odd raster
 F6BA  AC				lodsb
