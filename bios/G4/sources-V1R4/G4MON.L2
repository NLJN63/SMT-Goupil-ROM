					page ,132
					title GOUPIL4 PC compatible Rom I/O System
					subttl HWRE - hardware reset code

				;************************************************************************
				;*
				;*		iAPX-186 hardware reset code
				;*
				;************************************************************************

			     C	include macros.inc
			     C
			     C	morg	macro	 arg1  ;overlap detection macro
			     C		if1
			     C		if $ gt arg1
			     C		%out morg arg1 overlapping something!!!
			     C		endif
			     C		endif
			     C		org arg1
			     C		endm
			     C
			     C	link	macro	arg1,arg2	;set and print binlink info
			     C		if1
			     C		.radix	16
			     C		outmsg	cut,arg1,%(arg2)
			     C		outmsg	binlink,arg1,%(arg2-0c000h)
			     C		.radix	10
			     C		endif
			     C		org	arg2
			     C		endm
			     C
			     C	outmsg	macro	arg1,arg2,arg3
			     C		%out arg1 arg2 to arg3
			     C		endm
			     C

 0000				code	segment
					assume cs:code

				;************************************************************************
				;*
				;*		set and print H/W binary link offset
				;*
				;************************************************************************

				    link	hwre,0fff0h
 FFF0			      + 	org	0fff0h

				;************************************************************************
				;*
				;*		hardware reset entry point for iapx-186
				;*
				;************************************************************************
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-2
GOUPIL4 PC compatible Rom I/O System				08-02-85
				HWRE - hardware reset code


							; our actual cs:ip is ffff:0
 FFF0				RESET:
 FFF0  BA FFA0				MOV	DX,0FFA0H		;UPPER MEMORY  = EPROM (UMCS)
 FFF3  B8 F83A				MOV	AX,0F838H+2		;32K
 FFF6  EF				OUT	DX,AX
 FFF7  EA				db	0eah			;jump far to set cs:ip to fc00:2050
 FFF8  E050				dw	0e050h			;PC compatible entry!
 FFFA  F000				dw	0f000h

				;***************	End Of PROM Data	*****************

 FFFC				code	ends
					end
