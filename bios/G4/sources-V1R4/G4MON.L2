				;************************************************************************
				;*									*
				;*		sense_status (local)					*
				;*									*
				;************************************************************************
				;*									*
				;*	Wait for current command, then Send FDC sense interrupt status	*
				;*	CoMmanD OUT & return status result.				*
				;*									*
				;*	ENTRY:	AL= 0 indicates last cmd was seek or recal		*
				;*		AL= 1 indicate reset					*
				;*		AL= -1 indicate last cmd was first recal		*
				;*		DS = RDP segment					*
				;*		BP= new stack pointer on error				*
				;*									*
				;*	EXIT:	No error:	  Normal return.			*
				;*		Recal not completed: return non zero condition		*
				;*		Error condition:  terminate command			*
				;*				  AL= error type			*
				;*				  FD_Status(0-6)= FDC status result	*
				;*									*
				;*	MODIFIES:	RDP:FD_Status(0-6)				*
				;*			only ES & SI preserved				*
				;*									*
				;************************************************************************
 EED3				sense_status:
 EED3  50				push	ax			; save seek flag
 EED4  E8 EFD2 R			call	wait_rdy		; wait for controller rdy

 EED7  B0 08				mov	al,8			; FDC sense cmd
 EED9  E8 EF6B R			call	cmd_out

 EEDC  E8 EF06 R			call	get_status		; get sense results

 EEDF  A0 0000 E			mov	al, FD_Status		; check for proper seek

 EEE2  5A				pop	dx
 EEE3  0A D2				or	dl,dl			; check seek flag
 EEE5  75 0B				jne	ss_20			; it is a reset or a first recal

 EEE7  24 E0				and	al, 11100000b
 EEE9				ss_10:
 EEE9  3C 20				cmp	al, 00100000b		; seek pattern

 EEEB  74 18				je	ss_40			; bad seek
 EEED  B0 40				mov	al, FD_ERR_SEEK
 EEEF  E9 ECEC R			jmp	f_exit

 EEF2				ss_20:
 EEF2  78 0B				js	ss_30			; it is the first recal

 EEF4  24 E0				and	al, 11100000b
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-23
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMFD - floppy driver

 EEF6  3C C0				cmp	al, 11000000b		; reset pattern
 EEF8  74 0B				je	ss_40

 EEFA  B0 20				mov	al, FD_ERR_FDC		; bad FDC
 EEFC  E9 ECEC R			jmp	f_exit

 EEFF				ss_30:
 EEFF  24 F0				and	al,11110000b
 EF01  A8 10				test	al,00010000b		; recal completed
 EF03  74 E4				je	ss_10			; yes it is like a seek

 EF05				ss_40:
 EF05  C3				ret

