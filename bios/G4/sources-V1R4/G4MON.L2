				;	bx = expansion table for selected color

 F6E6				expand:
 F6E6  8A E0				mov	ah,al			;save byte
 F6E8  24 0F				and	al,0Fh			;expand low nibble of byte
 F6EA  2E: D7				xlat	cs:byte ptr[bx]
 F6EC  86 E0				xchg	ah,al			;save it
 F6EE  D0 E8				shr	al,1			;expand hi nibble of byte
 F6F0  D0 E8				shr	al,1
 F6F2  D0 E8				shr	al,1
 F6F4  D0 E8				shr	al,1
 F6F6  2E: D7				xlat	cs:byte ptr[bx]
 F6F8  C3				ret


