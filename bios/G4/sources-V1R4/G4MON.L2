 F6C9  C3				ret

 F6CA				gr_hi_xor:
 F6CA  26: 30 05			xor	es:[di],al		;xor raster of char for hi-res
 F6CD  47				inc	di			;next character
 F6CE  E2 FA				loop	gr_hi_xor		;..until all chars done
 F6D0  C3				ret

 F6D1				gr_med:
 F6D1  50				push	ax			;write raster of char in med-res
 F6D2  E8 F6E6 R			call	expand			;expand bits to pixel color
 F6D5  F3/ AB				rep	stosw			;write raster for chars
 F6D7  58				pop	ax			;restore reg
 F6D8  C3				ret

 F6D9				gr_med_xor:
