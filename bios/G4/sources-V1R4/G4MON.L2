				;************************************************************************
				;*									*
				;*		FD_Timer (public)					*
				;*									*
				;************************************************************************
				;*									*
				;*									*
				;*									*
				;*	ENTRY:	none							*
				;*									*
				;*	EXIT:	none							*
				;*									*
				;*	MODIFIES:							*
				;*									*
				;************************************************************************
 F9EF				FD_Timer:
 F9EF  50				push	ax
 F9F0  52				push	dx
 F9F1  1E				push	ds

				    set_RDP	ax
 F9F2  B8 ---- R	      + 	mov	ax, RDP
 F9F5  8E D8		      + 	mov	ds, ax

 F9F7  FF 06 0000 E			inc	Tmr_Counter.LW
 F9FB  75 04				jne	fdt_10
 F9FD  FF 06 0002 E			inc	Tmr_Counter.HW
 FA01				fdt_10:
 FA01  83 3E 0002 E 18			cmp	Tmr_Counter.HW,24	; 1193180/65536 * 24*60*60 / 65536
 FA06  72 16				jb	fdt_30
 FA08  77 08				ja	fdt_20

 FA0A  81 3E 0000 E 00B0		cmp	Tmr_Counter.LW,176	; 1193180/65536 * 24*60*60 MOD 65536
 FA10  72 0C				jb	fdt_30
 FA12				fdt_20:
					clr	ax
 FA12  33 C0		      + 	xor	ax,ax
 FA14  A3 0000 E			mov	Tmr_Counter.LW,ax
 FA17  A3 0002 E			mov	Tmr_Counter.HW,ax
 FA1A  FE 06 0000 E			inc	Tmr_Overflow
 FA1E				fdt_30:
 FA1E  80 26 0000 E FF			and	FD_Timeout,0FFh
 FA23  74 0E				je	fdt_50

 FA25  FE 0E 0000 E			dec	FD_Timeout
 FA29  75 08				jne	fdt_50

 FA2B  E8 FA39 R			call	FD_Motor_Off
 FA2E  80 26 0000 E F0			and	FD_Motor, 0F0h
 FA33				fdt_50:
 FA33  CD 1C				int	1Ch
 FA35  1F				pop	ds
