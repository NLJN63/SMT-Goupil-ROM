				;*.
				;************************************************************************
				;*									*
				;*	ROM VIDEO DRIVER						*
				;*									*
				;*	  DATE	  RELEASE		COMMENT 			*
				;*	--------  -------     -------------------------------------	*
				;*									*
				;************************************************************************
				;*.

				;************************************************************************
				;*									*
				;*	VIDEO  --  Video ROM Driver					*
				;*									*
				;************************************************************************
				;*									*
				;*	The video driver performs functions on the system monitor.	*
				;*	The driver detects the kind of monitor currently active 	*
				;*	(color or monochrome) via the equipment vector in the ROM	*
				;*	data page.  This driver is compatible with the IBM PC video	*
				;*	driver. 							*
				;*									*
				;*	Entry:	AH = function number.					*
				;*		Other regs set according to func (see below).		*
				;*									*
				;*	Exit:	Return regs set per function (see below).		*
				;*		AX destroyed, all other regs are preserved.		*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Set Video Mode							*
				;*									*
				;*	Set the video mode to one of the following:			*
				;*		0   -	40x25, b/w text 				*
				;*		1   -	40x25, color text				*
				;*		2   -	80x25, b/w text 				*
				;*		3   -	80x25, color text				*
				;*		4   -	320x200, color med-res graphics 		*
				;*		5   -	320x200, b/w med-res graphics			*
				;*		6   -	640x200, b/w hi-res graphics			*
				;*		7   -	80x25 monochrome (used internally)		*
				;*	This function reinitializes the hardware, clears the screen,	*
				;*	resets the cursor attributes, and positions all cursors to the	*
				;*	top of their text pages.					*
				;*									*
				;*	Entry:	AH = 0, 						*
				;*		AL = video mode.					*
				;*									*
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-2
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Set Cursor Attributes						*
				;*									*
				;*	Set the starting and ending rasters for the hardware cursor.	*
				;*	The start/end raster is 0..7 for color, 0..13 for monochrome.	*
				;*	Bits 6,5 of CH also set blink and display attributes of cursor. *
				;*	Bits 6,5 are off for normal cursor, 1,0 for cursor off: other	*
				;*	settings cause erratic cursor blinking. 			*
				;*									*
				;*	Entry:	AH = 1, 						*
				;*		CH = start cursor raster,				*
				;*		CL = ending cursor raster.				*
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Set Cursor Position						*
				;*									*
				;*	Set the cursor to the specified (row,column) of the specified	*
				;*	page, where (0,0) is the upper left corner of the page.  If	*
				;*	the specified page is the active page, the hardware cursor is	*
				;*	positioned on the screen.					*
				;*									*
				;*	Entry:	AH = 2, 						*
				;*		DH,DL = row,column,					*
				;*		BH = page.						*
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Get Cursor							*
				;*									*
				;*	Return the cursor position and attributes.			*
				;*									*
				;*	Entry:	AH = 3, 						*
				;*		BH = page.						*
				;*									*
				;*	Exit:	DH,DL = row,col of cursor,				*
				;*		CH,CL = cursor attributes.				*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Read Light Pen							*
				;*									*
				;*	Read light pen registers of the CRT controller chip.		*
				;*									*
				;*	Entry:	AH = 4. 						*
				;*									*
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-3
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

				;*	Exit:	AH = 0 if light pen switch not active,			*
				;*		AH = 1 if light pen registers are valid,		*
				;*		DH,DL = char cell row,col,				*
				;*		CH = raster line (0..199),				*
				;*		BX = pixel in raster (0..319 or 0..639).		*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Select Active Page						*
				;*									*
				;*	Select the text page to be displayed.  Valid only in text	*
				;*	modes with color adaptor.					*
				;*									*
				;*	Entry:	AH = 5, 						*
				;*		AL = new page (0..7 or 0..3).				*
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Scroll Up							*
				;*									*
				;*	Scroll a region of the active text page up by a specified	*
				;*	number of lines.						*
				;*									*
				;*	Entry:	AH = 6, 						*
				;*		CH,CL = row,col of upper left corner of region, 	*
				;*		DH,DL = row,col of bottom right corner of region,	*
				;*		BL = attribute used for blank lines,			*
				;*		AL = lines to scroll, zero to blank entire region.	*
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Scroll Down							*
				;*									*
				;*	Scroll a region of the active text page down by a specified	*
				;*	number of lines.						*
				;*									*
				;*	Entry:	AH = 7, 						*
				;*		CH,CL = row,col of upper left corner of region, 	*
				;*		DH,DL = row,col of bottom right corner of region,	*
				;*		BL = attribute used for blank lines,			*
				;*		AL = lines to scroll, zero to blank entire region.	*
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Read Character and Attribute					*
				;*									*
				;*	Read the character and attribute at the current cursor		*
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-4
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

				;*	position of the specified page. 				*
				;*									*
				;*	Entry:	AH = 8, 						*
				;*		BH = text page. 					*
				;*									*
				;*	Exit:	AL = character, 					*
				;*		AH = attribute (only valid in text modes).		*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Write Character and Attribute					*
				;*									*
				;*	Write the specified character and attribute at the current	*
				;*	cursor position of the specified text page.			*
				;*									*
				;*	Entry:	AH = 9, 						*
				;*		AL = character, 					*
				;*		BL = attribute, 					*
				;*		BH = text page, 					*
				;*		CX = number of chars to write.				*
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Write Character 						*
				;*									*
				;*	Write the specified character only at the current cursor	*
				;*	position of the specified text page.				*
				;*									*
				;*	Entry:	AH = 10,						*
				;*		AL = character, 					*
				;*		BH = text page, 					*
				;*		CX = number of chars to write.				*
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Set Palette							*
				;*									*
				;*	Set the color palette.	A color is associated with the a	*
				;*	palette ID.  For the current color card, the palette settings	*
				;*	are very limited.						*
				;*									*
				;*	Entry:	AH = 11,						*
				;*		BH = color ID,						*
				;*		BL = color to be used with color ID.			*
				;*									*
				;*		For color adaptor:					*
				;*		    text:	BH=0, BL= border color. 		*
				;*		    320x200:	BH=0, BL= background (0..15),		*
				;*				BH=1, BL=0->green(1),red(2),yellow(3),	*
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-5
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

				;*				      BL=1->cyan(1),magenta(2),white(3) *
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Write Pixel							*
				;*									*
				;*	Set the pixel to specified color.  If the msb of color is set,	*
				;*	then the pixel is exclusive-ORed into screen, otherwise it	*
				;*	overwrites the pre-existing pixel.				*
				;*									*
				;*	Entry:	AH = 12,						*
				;*		AL = color						*
				;*		CX = pixel in raster (0..319, 0..639),			*
				;*		DX = raster number (0..199).				*
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Read Pixel							*
				;*									*
				;*	Return the color of the specified pixel.			*
				;*									*
				;*	Entry:	AH = 13,						*
				;*		CX = pixel in raster (0..319, 0..639),			*
				;*		DX = raster number (0..199).				*
				;*									*
				;*	Exit:	AL = color.						*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	TTY Write							*
				;*									*
				;*	Write character at current cursor position of active page,	*
				;*	advancing cursor.  CR,LF,BELL,BS characters are interpreted.	*
				;*									*
				;*	Entry:	AH = 14,						*
				;*		AL = character, 					*
				;*		BL = foreground color, in graphics mode.		*
				;*									*
				;*	Exit:	None.							*
				;*									*
				;*----------------------------------------------------------------------*
				;*									*
				;*	Get State							*
				;*									*
				;*	Return the current video state. 				*
				;*									*
				;*	Entry:	AH = 15.						*
				;*									*
				;*	Exit:	AL = current video mode (0..7), 			*
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-6
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

				;*		AH = number of columns, 				*
				;*		BH = active display page.				*
				;*									*
				;************************************************************************




