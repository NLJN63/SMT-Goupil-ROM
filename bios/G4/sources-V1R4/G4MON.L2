					assume	ds:RDP

 F995  8A 26 0000 E			mov	ah,byte ptr equip_vect	;get equip vector video bits
 F999  25 3000				and	ax,3000h		;isolate video bits
 F99C  74 12				jz	initx			;no video, CALL RS232 HERE!! hsp

 F99E  80 FC 10 			cmp	ah,10h			;test if 40x25 color
 F9A1  74 09				je	init			;mode 0

 F9A3  B0 03				mov	al,3			;use mode 3...
 F9A5  80 FC 20 			cmp	ah, 20h 		; ...for 80x25 color hsp
 F9A8  74 02				je	init			; hsp

 F9AA  B0 07				mov	al, 7			; use mode 7 for 80x25 B/W hsp
