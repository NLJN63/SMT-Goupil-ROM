 F065			      + 	org 0f065h

 F065				VIDEO_ENTRY:

 F065  FB				sti				;interrupts okay
 F066  FC				cld

 F067  1E				push	ds			;save caller's registers
 F068  06				push	es			;..push order to match frame struc
 F069  55				push	bp
 F06A  57				push	di
 F06B  56				push	si
 F06C  52				push	dx
 F06D  51				push	cx
 F06E  53				push	bx
 F06F  50				push	ax

 F070  8B EC				mov	bp,sp			;set up stack frame

 F072  BE ---- R			mov	si,seg RDP		;get rom data page
 F075  8E DE				mov	ds,si
					assume	ds:RDP

 F077  80 FC 10 			cmp	ah,NBFUNC		;range check on function
 F07A  73 0C				jae	video_ret

 F07C  86 E0				xchg	ah,al			;index into dispatch table
 F07E  98				cbw
 F07F  D1 E0				shl	ax,1
 F081  8B F0				mov	si,ax
 F083  2E: FF 94 F045 R 		call	dsptab[si]		;dispatch to function

 F088				video_ret:
 F088  58				pop	ax			;restore regs/return values
 F089  5B				pop	bx
 F08A  59				pop	cx
 F08B  5A				pop	dx
 F08C  5E				pop	si
 F08D  5F				pop	di
 F08E  5D				pop	bp
 F08F  07				pop	es
 F090  1F				pop	ds

