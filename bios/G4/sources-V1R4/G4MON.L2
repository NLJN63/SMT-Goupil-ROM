			     C	link	macro	arg1,arg2	;set and print binlink info
			     C		if1
			     C		.radix	16
			     C		outmsg	cut,arg1,%(arg2)
			     C		outmsg	binlink,arg1,%(arg2-0c000h)
			     C		.radix	10
			     C		endif
