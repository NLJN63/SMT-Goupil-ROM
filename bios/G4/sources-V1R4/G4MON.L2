 F164  EE				out	dx,al			;change 8Mhz HW from color to mono

 F165  80 3E 0000 E 07			cmp	crt_mode,7		;check if monochrome
 F16A  75 08				jne	setmod2

 F16C  BA 03B4				mov	dx,3B4h 		;set for monochrome hsp
