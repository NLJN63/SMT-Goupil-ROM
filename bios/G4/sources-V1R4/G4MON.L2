				;************************************************************************
				;*									*
				;*		TOD_Rios public 					*
				;*									*
				;************************************************************************
				;*									*
				;*	Time of Day support for standard PC compatible timer &		*
				;*	special GOUPIL4 calendar/clock H/W.  There are two set and two	*
				;*	get functions as follows:					*
				;*----------------------------------------------------------------------*
				;*	ENTRY:	AH= 0	get 24 hour timer value 			*
				;*	EXIT:	CX|DX=	32 bit time since midnight, in 55 msec units.	*
				;*		AL=	number of times counter has passed midnight	*
				;*			since last Fn0 or Fn1 call.			*
				;*----------------------------------------------------------------------*
				;*	ENTRY:	AH= 1	set 24 hour timer value 			*
				;*		CX|DX=	32 bit time since midnight, in 55 msec units.	*
				;*	EXIT:	none							*
				;*----------------------------------------------------------------------*
				;*	ENTRY:	AH= FEh get calendar/clock values.			*
				;*	EXIT:	DL = year	(0..99) 				*
				;*		CH = month	(1..12) 				*
				;*		CL = day	(1..31) 				*
				;*		BH = hours	(0..23) 				*
				;*		BL = minutes	(0..59) 				*
				;*		AL = seconds	(0..59) 				*
				;*----------------------------------------------------------------------*
				;*	ENTRY:	AH= FFh set calendar/clock values.			*
				;*		DL = year	(0..99) 				*
				;*		CH = month	(1..12) 				*
				;*		CL = day	(1..31) 				*
				;*		BH = hours	(0..23) 				*
				;*		BL = minutes	(0..59) 				*
				;*		AL = seconds	(0..59) 				*
				;*	EXIT:	none							*
				;*									*
				;************************************************************************

				;************************************************************************
				;*
				;*		PC compatible TOD entry
				;*
				;************************************************************************

					morg	0fe6eh
 FE6E			      + 	org 0fe6eh

 FE6E				TOD_RIOS_entry:
 FE6E  80 FC 01 			cmp	ah, 1			; check for standard timer functions
 FE71  77 3C				ja	cal_rios		; special GOUPIL4 function for calendar H/W

 FE73  53				push	bx
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-17
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				TOD - time-of-day driver	and character generator set

 FE74  1E				push	ds
				    set_RDP	bx
 FE75  BB ---- R	      + 	mov	bx, RDP
 FE78  8E DB		      + 	mov	ds, bx
 FE7A  74 13				je	tod_set 		; Fn 1, set

 FE7C  8B 16 0000 E			mov	dx, Tmr_Counter.LW
 FE80  8B 0E 0002 E			mov	cx, Tmr_Counter.HW
 FE84  A0 0000 E			mov	al, Tmr_Overflow	; return timer values
 FE87				tod_exit_zto:
 FE87  C6 06 0000 E 00			mov	Tmr_Overflow, 0 	; clear midnight flag
 FE8C				tod_exit:
 FE8C  1F				pop	ds
 FE8D  5B				pop	bx
 FE8E				tod_out:
 FE8E  CF				iret
 FE8F				tod_set:				; set 24 hour timer
 FE8F  89 16 0000 E			mov	Tmr_Counter.LW,dx
 FE93  89 0E 0002 E			mov	Tmr_Counter.HW,cx
 FE97  EB EE				jmp	tod_exit_zto
