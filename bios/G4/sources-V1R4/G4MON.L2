			     C	INCLUDE DEFINES.DEF
 = 0000 		     C	B		equ	byte ptr 0
 = 0000 		     C	W		equ	word ptr 0
 = 0000 		     C	P		equ	dword ptr 0
			     C
 = 0000 		     C	LB		equ	byte ptr 0
 = 0001 		     C	HB		equ	byte ptr 1
 = 0000 		     C	LW		equ	word ptr 0
 = 0002 		     C	HW		equ	word ptr 2
 = 0002 		     C	SEL		equ	word ptr 2
 = 0000 		     C	OFF		equ	word ptr 0
			     C
 = 0000 		     C	NULL		equ	0
 = 0000 		     C	FALSE		equ	0
 =-0001 		     C	TRUE		equ	(not false)
 = 0000 		     C	E_OK		equ	0
			     C	INCLUDE PC.DEF
			     C	DSEG	macro	seg, text, reg
			     C	assume	DS:seg
			     C		mov	reg, seg
			     C		mov	ds, reg
			     C	endm
			     C
 =			     C	jc	equ	jb
 =			     C	jnc	equ	jnb
			     C
			     C	clr	macro	reg
			     C		xor	reg,reg
			     C	endm
			     C
			     C	jmps	macro	add
			     C		jmp	short	add
			     C	endm
			     C
			     C	pushE	macro		; save (everything) onto stack
			     C		push	ax
			     C		push	bx
			     C		push	cx
			     C		push	dx
			     C		push	si
			     C		push	di
			     C		push	bp
			     C		push	ds
			     C		push	es
			     C	endm
			     C
			     C	popE	macro		; restore (everything) from stack
