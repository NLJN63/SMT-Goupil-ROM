 F7D9  83 C4 08 			add	sp,8			;clear off stack
 F7DC  C3				ret



				;compress --
				;	this routine takes a word of color pixels and compresses
				;	it into a byte of bits, where the bits are set if the
				;	pixel was on (non-zero).
				;
				;	entry:	ax = word of pixels,
				;	exit:	al = byte,
				;		bx,cx are destroyed.

 F7DD				compress:
 F7DD  86 E0				xchg	ah,al
 F7DF  8B D8				mov	bx,ax			;copy pixels
 F7E1  81 E3 5555			and	bx,5555h		;mask the lsb of each pixel
 F7E5  D1 E3				shl	bx,1			;combine them with msbof each pixel
 F7E7  0B D8				or	bx,ax
 F7E9  B9 0008				mov	cx,8			;eight bits to do
 F7EC				comp:
 F7EC  D1 EB				shr	bx,1			;set psw.c if pixel is on
 F7EE  D1 EB				shr	bx,1
 F7F0  D0 D8				rcr	al,1			;move into result
 F7F2  E2 F8				loop	comp			;do each pixel

 F7F4  C3				ret

