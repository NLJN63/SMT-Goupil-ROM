 The Microsoft MACRO Assembler , Version 1.27 		Page	1-12
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

					page
				;************************************************************************
				;*									*
				;*	Macros								*
				;*									*
				;************************************************************************

				;  JGRP  --
				;	Take branch if in graphics mode.
				;
				;	Entry:	LABEL= name of label to branch to.
				;
				;	Exit:	None.

				JGRP	macro	LABEL
					local	@1

					cmp	crt_mode,4
					jb	@1
					cmp	crt_mode,6
					jbe	LABEL
				@1:
				endm



				;  JNGRP  --
				;	Take branch if not in graphics mode.
				;
				;	Entry:	LABEL= name of label to branch to.
				;
				;	Exit:	None.

				JNGRP	macro	LABEL
					cmp	crt_mode,4
					jb	LABEL
					cmp	crt_mode,6
					ja	LABEL
				endm



				; CRTOUT  --
				;	A pair of the 6845 CRT controller registers are set.
				;
				;	Entry:	REG= number of reg pair to be set,
				;		CX= values of registers.
				;
				;	Exit:	DX and AL are destroyed.

				CRTOUT	macro	REG
					mov	dx,crt_iobase		;get port address of 6845
					mov	al,REG			;select first reg to be set
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-13
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

					out	dx,al
					inc	dx
					mov	al,ch			;get first value
					out	dx,al			;output it to register
					dec	dx
					mov	al,REG+1		;second register to be set
					out	dx,al
					inc	dx
					mov	al,cl			;get second value
					out	dx,al			;output it to register
				endm



				; CURSINX  --
				;	Get index into cursor table.
				;
				;	Entry:	PAGE= text page.
				;
				;	Exit:	BX= index into cursor table.

				CURSINX macro	PAGE

				ifdif	<PAGE>,<BL>
					mov	bl,PAGE
				endif
					xor	bh,bh
					shl	bx,1
				endm



				; GETCURS  --
				;	Get the current cursor position.
				;
				;	Entry:	PAGE= text page.
				;
				;	Exit:	DX= cursor pos (row,col).
				;		BX= index into cursor table.

				GETCURS macro	PAGE
				ifb	<PAGE>
					mov	dx,crt_curs_pos[0]
				else
					CURSINX <PAGE>			;get cursor index
					mov	dx,crt_curs_pos[bx]	;bx gets cursor position
				endif
				endm



				; TEXTOFF  --
				;	Calculate screen offset of character cell in text modes.
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-14
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

				;
				;	Entry:	DX= row,col
				;
				;	Exit:	AX= address within screen ram of char cell.
				;		DX is destroyed.

				TEXTOFF macro
					xor	ax,ax			;al = row, dx = col
					xchg	al,dh
					mul	byte ptr crt_cols	;char cell in screen
					add	ax,dx
					shl	ax,1			;convert to byte offset
				endm


				;  GRPOFF  --
				;	Calculate screen offset to character cell in graphics mode.
				;
				;	Entry:	DX= row,col.
				;
				;	Exit:	AX= offset of first byte of character.
				;		DX is destroyed.

				GRPOFF	macro
					local	@1

					mov	al,160			;ax gets row * (8*80)/2
					mul	dh
					shl	ax,1
					xor	dh,dh			;dx = column

					cmp	crt_mode,6		;check if hires
					je	@1
					shl	dx,1			;med res: char width is a word
				@1:	add	ax,dx			;add horiz offset to raster

				endm





				;  SCRPTR  --
				;	Form a pointer to the char cell in screen ram at the cursor.
				;
				;	Entry:	DX= cursor position.
				;		PAGE= text page.
				;
				;	Exit:	ES:DI= pointer to char cell.
				;		AX= screen segment,
				;		BX,DX are destroyed.

				SCRPTR	macro	PAGE
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-15
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMCRT -	video driver

					TEXTOFF 			;get screen offset
					mov	di,ax			;DI gets pointer
					mov	al,PAGE 		;recover page
					cbw
					mul	crt_regen_leng		;calc page offset
					add	di,ax			;add offset into address
					SCRSEG				;ax gets screen segment
					mov	es,ax			;es:di gets ptr to char cell
				endm



				;  SCRSEG  --
				;	Get the screen segment address in the specified register.
				;
				;	Entry:	None.
				;
				;	Exit:	AX set to screen segment.

				SCRSEG	macro
					local	@1
					mov	ax,0B800h		;assume color
					cmp	crt_mode,7		;check if monochrome
					jne	@1
					mov	ax,0B000h		;set for monochrome
				@1:
				endm




