				;************************************************************************
				;*									*
				;*		FD_Motor_On  (local)					*
				;*									*
				;************************************************************************
				;*									*
				;*	turn on floppy disk motor					*
				;*									*
				;*	ENTRY:	AL= drive number					*
				;*	EXIT:	(none)							*
				;*	MODIFIES:   All GP registers					*
				;*									*
				;************************************************************************
 EC43				FD_Motor_On:
 EC43  8A C8				mov	cl,al			; save drive #
 EC45  B0 10				mov	al,010h 		; drive enable bit
 EC47  D2 E0				shl	al,cl
 EC49  0A C1				or	al,cl			; drive select
 EC4B  0C 0C				or	al,0Ch			; enable FDC & no reset
 EC4D  BA 03F2				mov	dx, 03F2h
 EC50  EE				out	dx,al

 EC51  C3				ret

				;************************************************************************
				;*
				;*	Set up PC compatible org for S/W floppy interrupt
				;*
				;************************************************************************

					morg	0ec59h
 EC59			      + 	org 0ec59h
 EC59				FD_RIOS_entry:
 EC59  EB 69 90 			jmp	fd_rios
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-9
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMFD - floppy driver

