				; common scroll/blank code for text modes
				;
				;	si	= source pointer
				;	di	= destination pointer
				;	dx	= row delta (+/-)
				;	cx	= chars to copy/fill per line
				;	bh	= number of lines to copy
				;	bl	= number of lines to blank
				;	attrs	= top of stack, high byte

 F3DD				text_scroll:
					SCRSEG				;get screen ram segment
 F3DD  B8 B800		      + 	mov	ax,0B800h		;assume color
 F3E0  80 3E 0000 E 07	      + 	cmp	crt_mode,7		;check if monochrome
 F3E5  75 03		      + 	jne	??0001
 F3E7  B8 B000		      + 	mov	ax,0B000h		;set for monochrome
 F3EA			      + ??0001:
 F3EA  8E D8				mov	ds,ax
 F3EC  8E C0				mov	es,ax

 F3EE				copyrow:
 F3EE  56				push	si			;save source/dest pointers
 F3EF  57				push	di
 F3F0  51				push	cx			;..and char count for row
 F3F1  F3/ A5				rep	movsw			;copy line
 F3F3  59				pop	cx			;restore count
 F3F4  5F				pop	di			;..and src/dest pointers
 F3F5  5E				pop	si
 F3F6  03 F2				add	si,dx			;update ptrs to next row
 F3F8  03 FA				add	di,dx
 F3FA  FE CF				dec	bh			;check if done copying
 F3FC  75 F0				jnz	copyrow

 F3FE				filltext:
 F3FE  58				pop	ax			;restore fill char attr in ah
 F3FF  B0 20				mov	al,' '			;fill remaining rows with blanks
 F401				fillrow:
 F401  57				push	di			;save dest pointer
 F402  51				push	cx			;..and row count
