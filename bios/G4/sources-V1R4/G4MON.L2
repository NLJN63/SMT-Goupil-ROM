				;************************************************************************
				;*									*
				;*	SET_MODE  --							*
				;*									*
				;************************************************************************

					assume	cs:Code, ds:RDP, es:nothing

 F11C				SET_MODE:

 F11C  8A 46 00 			mov	al,[bp].RAL		;restore AL
 F11F  24 07				and	al,7			;mask insignificant bits of mode
 F121  8A 26 0000 E			mov	ah,byte ptr equip_vect	;check equip vector for color adaptor
 F125  80 E4 30 			and	ah,30h
 F128  80 FC 30 			cmp	ah,30h
 F12B  75 02				jne	setmod1
 F12D  B0 07				mov	al,7			;set mode for monochrome adaptor

					;init video params in rom data page
 F12F				setmod1:
 F12F  A2 0000 E			mov	crt_mode,al		;save new mode

 F132  B4 07				mov	ah,size modprms 	;form index into parms tables
 F134  F6 E4				mul	ah
 F136  05 F0E4 R			add	ax,offset Code:parmtab	;address of parm table for mode
 F139  8B F0				mov	si,ax

 F13B  2E: AD				lods	cs:word ptr[si] 	;get offset into video params
 F13D  50				push	ax			;..save it on stack

 F13E  2E: AD				lods	cs:word ptr[si] 	;number of columns
 F140  A3 0000 E			mov	crt_cols,ax

 F143  2E: AD				lods	cs:word ptr[si] 	;regen buffer length
 F145  A3 0000 E			mov	crt_regen_leng,ax

 F148  2E: AC				lods	cs:byte ptr[si] 	;mode reg setting
 F14A  A2 0000 E			mov	crt_mode_reg,al

 F14D  8C D8				mov	ax,ds			;es gets data page
 F14F  8E C0				mov	es,ax
					assume	es:RDP

 F151  BF 0000 E			mov	di,offset crt_curs_pos	;init cursors for all pages
 F154  B9 0008				mov	cx,8
 F157  33 C0				xor	ax,ax
 F159  F3/ AB				rep	stosw
 F15B  A2 0000 E			mov	crt_curr_page,al	;init active page
 F15E  A3 0000 E			mov	crt_regen_base,ax	;init regen buffer offset

					;disable video output

