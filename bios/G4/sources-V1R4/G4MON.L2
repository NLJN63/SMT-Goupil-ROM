				;************************************************************************
				;*									*
				;*		FD_Rios (S/W interrupt) 				*
				;*									*
				;************************************************************************
				;*									*
				;*	Floppy disk Rios interface					*
				;*									*
				;*	ENTRY (for all functions):					*
				;*		AH = Function code					*
				;*		IVT #1Eh points to disk parms				*
				;*									*
				;*	EXIT (for all functions):					*
				;*		PSW.C clear: no error (AH= 0)				*
				;*		PSW.C set:   AH= error value				*
				;*									*
				;*	MODIFIES:	All registers but AX preserved. 		*
				;*	ASSUMES:	All values are in proper range (no checking).	*
				;*	LIMITATIONS:	Only one track may be accessed per operation.	*
				;*									*
				;*----------------------------------------------------------------------*
				;*	Fn0: reset disk system --  FDC is reset, next op to any drive	*
				;*	will cause head recalibration.					*
				;*									*
				;*	ENTRY:	AH= 0							*
				;*	EXIT:	(none)							*
				;*----------------------------------------------------------------------*
				;*	Fn1: read system status from last operation			*
				;*									*
				;*	ENTRY:	AH= 1							*
				;*	EXIT:	AL= status value					*
				;*----------------------------------------------------------------------*
				;*	Fn2: read sectors from one track into memory			*
				;*									*
				;*	ENTRY:	AH= 2							*
				;*		DL= drive number (0-3)					*
				;*		DH= head number (0-1)					*
				;*		CH= track number (0-39) 				*
				;*		CL= sector number (1-9) 				*
				;*		AL= number of sectors (1-9)				*
				;*		es:[bx]= address for deposit of data			*
				;*									*
				;*	EXIT:	AL= number of sectors properly read			*
				;*----------------------------------------------------------------------*
				;*	Fn3: write sectors of one track from memory			*
				;*									*
				;*	ENTRY:	AH= 3							*
				;*		DL= drive number (0-3)					*
				;*		DH= head number (0-1)					*
				;*		CH= track number (0-39) 				*
				;*		CL= sector number (1-9) 				*
				;*		AL= number of sectors (1-9)				*
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-13
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMFD - floppy driver

				;*		es:[bx]= address of data to write			*
				;*									*
				;*	EXIT:	AL= number of sectors properly written			*
				;*----------------------------------------------------------------------*
				;*	Fn4: verify data checksum of sectors				*
				;*									*
				;*	ENTRY:	AH= 4							*
				;*		DL= drive number (0-3)					*
				;*		DH= head number (0-1)					*
				;*		CH= track number (0-39) 				*
				;*		CL= sector number (1-9) 				*
				;*		AL= number of sectors (1-9)				*
				;*									*
				;*	EXIT:	AL= number of sectors properly verified 		*
				;*----------------------------------------------------------------------*
				;*	Fn5: format track						*
				;*									*
				;*	ENTRY:	AH= 5							*
				;*		DL= drive number (0-3)					*
				;*		DH= head number (0-1)					*
				;*		CH= track number (0-39) 				*
				;*		es:[bx]= buffer of address fields, 4 bytes for each	*
				;*			sector per track (as defined by the disk parms).*
				;*			Fields: 1) track, 2) head, 3) sector, & 4) bytes*
				;*			per sector:  0=128, 1=256, 2=512, 3=1024.	*
				;*									*
				;*	EXIT:	(none)							*
				;*									*
				;************************************************************************
 ECC4				FD_RIOS:
 ECC4  FB				sti
 ECC5  86 C4				xchg	al, ah			; switch cmd & # sectors
					pushE
 ECC7  50		      + 	push	ax
 ECC8  53		      + 	push	bx
 ECC9  51		      + 	push	cx
 ECCA  52		      + 	push	dx
 ECCB  56		      + 	push	si
 ECCC  57		      + 	push	di
 ECCD  55		      + 	push	bp
 ECCE  1E		      + 	push	ds
 ECCF  06		      + 	push	es
 ECD0  8B EC				mov	bp,sp			; save stack pointer for ref & exit

					set_RDP bx
 ECD2  BB ---- R	      + 	mov	bx, RDP
 ECD5  8E DB		      + 	mov	ds, bx
					assume	ds:RDP

					clr	bx
 ECD7  33 DB		      + 	xor	bx,bx
 ECD9  8E C3				mov	es, bx			; reference disk parm table
 ECDB  26: C4 36 0078			les	si, es:[1Eh*4].P	; point es:si to disk parms
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-14
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMFD - floppy driver


						; only CX, DX, & AX (xchged) are RIOS parms
 ECE0  3C 01				cmp	al, 1			; 3 way branch
 ECE2  72 26				jb	f_reset
 ECE4  77 4A				ja	f_io

				;----- Fn1: system status return

 ECE6				f_status:
 ECE6  A0 0000 E			mov	al, FD_Result		; set return status in al
 ECE9  88 46 10 			mov	[bp].RAX.LB, al

				;----- normal & abort exit

 ECEC				f_exit:
 ECEC  88 46 11 			mov	[bp].RAX.HB, al 	; set return val for ah
 ECEF  A2 0000 E			mov	FD_Result, al		; set final status
 ECF2  3C 01				cmp	al, 1			; set PSW.C if error
 ECF4  F5				cmc

 ECF5  26: 8A 44 02			mov	al, es:[si].fd_mwait	; reset motor wait time
 ECF9  A2 0000 E			mov	FD_Timeout, al

 ECFC  8B E5				mov	sp, bp			; restore stack frame
					popE				; restore all registers
 ECFE  07		      + 	pop	es
 ECFF  1F		      + 	pop	ds
 ED00  5D		      + 	pop	bp
 ED01  5F		      + 	pop	di
 ED02  5E		      + 	pop	si
 ED03  5A		      + 	pop	dx
 ED04  59		      + 	pop	cx
 ED05  5B		      + 	pop	bx
 ED06  58		      + 	pop	ax

 ED07				FD_done proc	far
 ED07  CA 0002				ret	2			; return flag in carry
 ED0A				FD_done endp

 The Microsoft MACRO Assembler , Version 1.27 		Page	1-15
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				ROMFD - floppy driver

				  page

				;----- reset the FDC and indicate recal for all drives

 ED0A				f_reset:
								; only CX, DX, & AX (xchged) are RIOS parms
