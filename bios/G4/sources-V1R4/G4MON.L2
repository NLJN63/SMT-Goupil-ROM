				;************************************************************************
				;*
				;*
				;************************************************************************

				;************************************************************************
				;*									*
				;*		interval_timer interrupt				*
				;*									*
				;************************************************************************
				;*									*
				;*	interval timer hardware interrupt service			*
				;*									*
				;*	ENTRY:	(none)							*
				;*	EXIT:	(none)							*
				;*									*
				;************************************************************************

				;************************************************************************
				;*
				;*		PC compatible org'd hardware timer interrupt
				;*		(just barely snuck in here)
				;*
				;************************************************************************

					morg	0fea5h
 FEA5			      + 	org 0fea5h

 FEA5				interval_timer:
 FEA5  E8 F9EF R			call	FD_Timer		; timer dispatch

 FEA8  50				push	ax
 FEA9  B0 20				mov	al,20h			; EOI to PIC
 FEAB  E6 20				out	20h,al
 FEAD  58				pop	ax
 FEAE  CF				iret

 FEAF				cal_rios:				; calendar/clock chip support
 FEAF  80 FC FE 			cmp	ah, 0FEh
 FEB2  72 DA				jb	tod_out 		;invalid Func...
									; save registers used
 FEB4  06				push	es
 FEB5  1E				push	ds
 FEB6  55				push	bp
 FEB7  56				push	si
 FEB8  57				push	di
									; switch registers for GOUPIL4 code
 FEB9  8A E3				mov	ah,bl
 FEBB  8A DF				mov	bl,bh
 FEBD  B7 00				mov	bh,0			; day of week not used

 The Microsoft MACRO Assembler , Version 1.27 		Page	1-19
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				TOD - time-of-day driver	and character generator set

 FEBF  52				push	dx
 FEC0  51				push	cx
 FEC1  53				push	bx
 FEC2  50				push	ax
									; set es to ss
 FEC3  16				push	ss
 FEC4  07				pop	es

 FEC5  75 03				jne	cal_FF			; Set cal Fn
 FEC7  EB 6A 90 			jmp	cal_FE			; Get cal Fn


				;------ CAL RIOS Function FF (set) ---------
 FECA				cal_FF:
				;------------------------------------------
				; WRITE CALENDAR ROUTINE.
 FECA  B9 0064				mov	cx,100			;for time out
				; BEGIN PROCEDURE
 FECD				WRITEBEG:
 FECD  FB				STI				;ENABLE INTERRUPTS
 FECE  B3 00				MOV	BL,0			;STARTING REGISTER
 FED0  8B F4				mov	si,sp			;SET DATA POINTER
 FED2  FA				CLI				;DISABLE INTERRUPTS
				; LOOP WITH READ/WRITE ENABLED
 FED3				WRITELUP:
 FED3  E8 FFBA R			CALL	GETBUZY 		;LECTURE DU BUSY BIT
 FED6  E1 F5				loopZ	WRITEBEG		;NO. BR TO BEGIN
 FED8  74 51				jz	write_exit		;CALENDAR NOT AVAILABLE
				; GET DATA BYTE
 FEDA  32 E4				XOR	AH,AH			;CLEAR
 FEDC  26: 8A 04			MOV	AL,ES:[SI]		;GET BYTE FROM WORK AREA
 FEDF  80 FB 06 			CMP	BL,6			;DAY OF THE WEEK?
 FEE2  74 10				JE	WRITEDWK		;YES. BR WRITE DAY OF THE WEEK
 FEE4  7F 07				JG	WRITEDT 		;GREATER=DATE
				; WRITE TIME
 FEE6  F6 C3 01 			TEST	BL,1			;ODD REGISTER?
 FEE9  75 10				JNZ	WRITEHI 		;YES. BR TO WRITE TIME HIGH
 FEEB  EB 08				JMP short WRITELO		;ELSE. BR TO WRITE LOW
				; WRITE DATE
 FEED  F6 C3 01 		WRITEDT:TEST	BL,1			;ODD REGISTER?
 FEF0  75 03				JNZ	WRITELO 		;YES. BR TO WRITE DATE LOW
 FEF2  EB 07				JMP short WRITEHI		;ELSE. BR TO WRITE HIGH
				; WRITE DAY OF THE WEEK
 FEF4				WRITEDWK:
 FEF4  46				INC	SI			;ADVANCE INDEX
				; WRITE LOW 4 BITS
 FEF5				WRITELO:
 FEF5  D4 0A				aam				;DIVIDE BY 10 (AH=div, AL=mod)
 FEF7  8A F8				MOV	BH,al			;REMAINDER = DATA. HANG ON TO IT.
 FEF9  EB 0D				JMP short WRITEEXE		;BR TO EXECUTE
				; WRITE HIGH 4 BITS
 FEFB				WRITEHI:
 FEFB  46				INC	SI			;ADVANCE INDEX
 The Microsoft MACRO Assembler , Version 1.27 		Page	1-20
GOUPIL4 PC compatible Rom	I/O System				08-02-85
				TOD - time-of-day driver	and character generator set

 FEFC  D4 0A				aam				;DIVIDE BY 10 (AH=div, AL=mod)
 FEFE  8A FC				MOV	BH,ah			;QUOTIENT = DATA. HANG ON TO IT.
 FF00  80 FB 05 			CMP	BL,5			;HOURS HIGH?
 FF03  75 03				JNE	WRITEEXE		;NO. BR TO EXECUTE
 FF05  80 CF 08 			OR	BH,8			;INDICATE 24 HOURS CLOCK
				; EXECUTE WRITE
 FF08				WRITEEXE:
 FF08  8A C3				MOV	AL,BL			;REGISTER NUMBER
 FF0A  B2 BC				MOV	DL,LOW CALDAT
 FF0C  EE				OUT	DX,AL
				; SET WRITE HIGH
 FF0D  B0 14				MOV	AL,CADDRW+CSELECT
 FF0F  42				inc	dx	;MOV	DX,CALCTL
 FF10  EE				OUT	DX,AL			;WRITE ADDRESS
				; SET WRITE LOW
 FF11  B0 04				MOV	AL,CSELECT
							;MOV	DX,CALCTL
 FF13  EE				OUT	DX,AL			;SET WRITE ADDRESS LOW
				; SET VALUE
 FF14  8A C7				MOV	AL,BH			;DATA VALUE
 FF16  4A				dec	dx	;MOV	DX,CALDAT
 FF17  EE				OUT	DX,AL
				; SET WRITE HIGH
 FF18  B0 05				MOV	AL,CWRITE+CSELECT
 FF1A  42				inc	dx	;MOV	DX,CALCTL
 FF1B  EE				OUT	DX,AL			;WRITE VALUE
				; SET WRITE LOW
 FF1C  B0 04				MOV	AL,CSELECT
							;MOV	DX,CALCTL
 FF1E  EE				OUT	DX,AL			;SET WRITE LOW
				; TEST FOR END OF LOOP
 FF1F  FE C3				INC	BL			;INCREMENT REGISTER
 FF21  80 FB 0D 			CMP	BL,13			;ALL REGISTERS DONE?
 FF24  7E AD				JLE	WRITELUP		;NO. REPEAT LOOP
				; TEST IF READ/WRITE STILL ENABLED
 FF26  E8 FFBA R			CALL	GETBUZY 		;GET CAL CHIP NOT BUSY LINE
 FF29  E1 A2				loopz	WRITEBEG		;PROCEDURE NO GOOD. REDO IT.
				; WRITE DONE
 FF2B				write_exit:
 FF2B  B0 00				MOV	AL,0
 FF2D  B2 BD				MOV	DL,LOW CALCTL
 FF2F  EE				OUT	DX,AL			;SET CHIP SELECT LOW
 FF30  EB 78 90 			jmp	cal_exit


				;------ CAL RIOS Function FE (get) ---------

 FF33				cal_FE:

				; BEGIN PROCEDURE
 FF33  B9 0064				mov	cx,100
 FF36  FB			READBEG:STI				;ENABLE INTERRUPTS
 FF37  B3 00				MOV	BL,0			;STARTING REGISTER
