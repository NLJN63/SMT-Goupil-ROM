				;************************************************************************
				;*									*
				;*		cmd_out (local) 					*
				;*									*
				;************************************************************************
				;*									*
				;*	Send one byte of FDC CoMmanD OUT				*
				;*									*
				;*	ENTRY:	AL = byte to output					*
				;*		DS = RDP segment					*
				;*		BP= new stack pointer on error				*
				;*									*
				;*	EXIT:	No error:	  Normal return.			*
				;*		Error condition:  terminate command			*
				;*				  AL= error type			*
				;*				  FD_Status(0-6)= FDC status result.	*
				;*									*
				;*	MODIFIES:	RDP:FD_Status(0-6)				*
				;*			only ES & SI preserved				*
				;*									*
				;************************************************************************
 EF6B				cmd_out:
 EF6B  E8 EF76 R			call	FD_ByteOut		; send byte to controller
 EF6E  72 01				jc	co_10			; timeout error
 EF70  C3				ret
 EF71				co_10:
 EF71  B0 80				mov	al, FD_ERR_TO
 EF73  E9 ECEC R			jmp	f_exit			; abort

