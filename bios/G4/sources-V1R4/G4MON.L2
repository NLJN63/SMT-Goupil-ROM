				;*									*
				;************************************************************************
				;*									*
				;*	Floppy Disk Hardware Interrupt service				*
				;*									*
				;*	ENTRY:	(none)							*
				;*	EXIT:	(none)							*
				;*									*
				;************************************************************************

				;************************************************************************
				;*
				;*		Set PC compatible org for H/W interrupt
				;*
				;************************************************************************

					morg 0ef57h
 EF57			      + 	org 0ef57h
 EF57				FD_IRQ:
 EF57  FB				sti				; allow higher priority IRQ's
 EF58  1E				push	ds			; save registers used
 EF59  50				push	ax

				    set_RDP	ax
 EF5A  B8 ---- R	      + 	mov	ax, RDP
 EF5D  8E D8		      + 	mov	ds, ax
 EF5F  80 0E 0000 E 80			or	FD_Seek, FD_INT_BIT	; indicate command complete
									; make fd interrupt ready
 EF64  B0 20				mov	al,20h
 EF66  E6 20				out	20h, al
									; restore registers used
 EF68  58				pop	ax
 EF69  1F				pop	ds
 EF6A  CF				iret

