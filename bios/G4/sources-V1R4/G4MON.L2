				;************************************************************************
				;*									*
				;*	SET_PALETTE  -- 						*
				;*									*
				;************************************************************************

					assume	cs:Code, ds:RDP, es:nothing

 F1F8				SET_PALETTE:

 F1F8  80 3E 0000 E 07			cmp	crt_mode,7		;check if color adaptor
 F1FD  73 27				jae	pal_ret 		;if so, do nothing

 F1FF  8B 16 0000 E			mov	dx,crt_iobase		;get port addr of color reg
 F203  83 C2 05 			add	dx,5
 F206  A0 0000 E			mov	al,crt_palette		;recover the color reg image

 F209  80 FF 01 			cmp	bh,1			;palette id
 F20C  74 0B				je	pal_1			;id = 1
 F20E  77 16				ja	pal_ret 		;invalid palette: do nothing

					; set background color
 F210				pal_0:
 F210  24 E0				and	al,not PAL_BG_BITS	;mask off old background
 F212  80 E3 1F 			and	bl,PAL_BG_BITS		;fold in new bg color bits
 F215  0A C3				or	al,bl
 F217  EB 09				jmp	short pal_set

					; select med-res color pallete
 F219				pal_1:
 F219  24 DF				and	al,not PAL_SEL_BIT	;mask off old palette selection
 F21B  F6 C3 01 			test	bl,1			;check new setting
 F21E  74 02				jz	pal_set 		;select palette 0
 F220  0C 20				or	al,PAL_SEL_BIT		;select palette 1

					; set new value for color reg
